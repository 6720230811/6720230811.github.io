---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PostPanels from '../components/PostPanels.astro';
import { browseCanonical, browseTab } from '../lib/browse';
import { profile } from '../data/profile';
import { toLocale, useTranslations } from '../i18n/ui';

const locale = toLocale('zh');
const t = useTranslations(locale);
const p = profile[locale];
const tab = browseTab(locale, 'archive');

const title = `${tab.label} · ${p.name}`;
---

<BaseLayout profile={p} locale={locale} title={title} canonical={browseCanonical(locale)} description={t('archive.title')} rail>
  <Section title={tab.label} icon={tab.icon} titleId="browse-title" iconId="browse-icon">
    <PostPanels locale={locale} active="archive" titleId="browse-title" iconId="browse-icon" />
  </Section>
</BaseLayout>
