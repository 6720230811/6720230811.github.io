---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import PostPanels from '../../components/PostPanels.astro';
import { browseTab } from '../../lib/browse';
import { profile } from '../../data/profile';
import { toLocale, useTranslations } from '../../i18n/ui';

// 语言写死，不依赖 Astro.currentLocale（动态路由下不可靠）
const locale = toLocale('zh');
const t = useTranslations(locale);
const p = profile[locale];
const tab = browseTab(locale, 'all');

const title = `${tab.label} · ${p.name}`;
---

<BaseLayout profile={p} locale={locale} title={title} description={t('blog.title')}>
  <Section title={tab.label} icon={tab.icon} titleId="browse-title" iconId="browse-icon">
    <PostPanels locale={locale} active="all" titleId="browse-title" iconId="browse-icon" />
  </Section>
</BaseLayout>
