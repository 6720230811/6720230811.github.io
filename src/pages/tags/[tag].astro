---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import PostList from '../../components/PostList.astro';
import PostRedirect from '../../components/PostRedirect.astro';
import { profile } from '../../data/profile';
import { href, postsOf, tagKeysIn } from '../../lib/posts';
import { legacyTermRoutes, tagLabel } from '../../lib/taxonomy';
import { toLocale, useTranslations, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
  /** 词表里的标签 key（真页面才有） */
  key?: string;
  /** 有值 = 这一页是旧地址的跳转页，值是新地址（词条页根之下的路径，如 tags/astro） */
  redirect?: string;
}

/**
 * 标签页只为**文章里真正用到**的标签生成（标签是检索索引，没有预置的词），
 * 外加迁移前的旧地址（`/tags/前端/`）各落地一个跳转页。
 */
export async function getStaticPaths() {
  const locale = toLocale('zh');
  const posts = await postsOf(locale);

  const real = tagKeysIn(posts).map((key) => ({
    params: { tag: key },
    props: { locale, key },
  }));

  const legacy = legacyTermRoutes(locale, 'tags').map(({ from, to }) => ({
    params: { tag: from },
    props: { locale, redirect: to },
  }));

  return [...real, ...legacy];
}

const { locale, key = '', redirect } = Astro.props;
const t = useTranslations(locale);
const p = profile[locale];

const label = redirect ? '' : tagLabel(locale, key);
const posts = redirect ? [] : (await postsOf(locale)).filter((post) => post.data.tags.includes(key));

const title = `${t('tag.label')}：${label} · ${p.name}`;
---

{
  redirect ? (
    <PostRedirect
      title={`${t('tag.label')} · ${p.name}`}
      href={href(locale, redirect)}
      locale={locale}
    />
  ) : (
    <BaseLayout profile={p} locale={locale} title={title} description={title} rail>
      <Section title={`${t('tag.label')}：${label}`} icon="🏷">
        <p class="list-summary">
          {posts.length} {t('archive.count')}
        </p>
        <PostList posts={posts} locale={locale} />
      </Section>
    </BaseLayout>
  )
}
