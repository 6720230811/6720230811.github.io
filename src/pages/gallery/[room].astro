---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import GalleryFloor from '../../components/gallery/GalleryFloor.astro';
import GalleryGrid from '../../components/gallery/GalleryGrid.astro';
import GalleryLightbox from '../../components/gallery/GalleryLightbox.astro';
import '../../styles/gallery.css';
import { profile } from '../../data/profile';
import { roomById, roomLabel, roomMood, rooms } from '../../data/gallery';
import { toLocale, useTranslations } from '../../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

// 两种策展共用一个动态路由：房间 id 自带前缀（theme-city / year-2024），不会撞
export function getStaticPaths() {
  return [
    ...rooms('theme').map((room) => ({ params: { room: room.id }, props: { room } })),
    ...rooms('year').map((room) => ({ params: { room: room.id }, props: { room } })),
  ];
}

const { room } = Astro.props;

const locale = toLocale('zh');
const t = useTranslations(locale);
const p = profile[locale];

// 静态生成时 props 已带 room，这里再兜一次底，避免手改 url 时整页报错
const found = roomById(room.view, room.id);
if (!found) return Astro.redirect(getRelativeLocaleUrl(locale, 'gallery'));

const mood = roomMood(found);
const label = roomLabel(found, locale);

/**
 * 房间之间已经打通：这一页装的是同一策展视图下的整层展厅，只是从当前这间
 * 出生。所以要把同一视图的所有房间（含各自的配色与简介）一起交给脚本，
 * 网格也按房间分段列全。
 */
const siblings = rooms(found.view);
const floorRooms = siblings.map((item) => ({
  id: item.id,
  label: roomLabel(item, locale),
  intro: roomMood(item).intro?.[locale] ?? `${item.items.length} ${t('gallery.itemCount')}`,
  mood: roomMood(item),
  items: item.items,
}));
const total = siblings.reduce((sum, item) => sum + item.items.length, 0);
const intro = mood.intro?.[locale] ?? `${siblings.length} ${t('gallery.roomCount')} · ${total} ${t('gallery.itemCount')}`;

// 回到同一策展的房间索引：按时间布展的房间回 /gallery/year/
const backUrl =
  found.view === 'year'
    ? `${getRelativeLocaleUrl(locale, 'gallery')}year/`
    : getRelativeLocaleUrl(locale, 'gallery');
---

<BaseLayout
  profile={p}
  locale={locale}
  title={`${label} · ${t('gallery.title')}`}
  description={intro}
>
  <Section title={label} titleId="gal-room-title" icon="🖼">
    {/* data-mode 由脚本切换：默认 grid（也是无 JS / 无 WebGL 的形态），能用 3D 才切到 3d */}
    <div class="gal-page" id="gal-page" data-mode="grid">
      <div class="gal-head">
        <div class="gal-head__title">
          <span class="gal-head__view">{t(`gallery.view.${found.view}`)}</span>
          <p class="gal-head__intro" id="gal-room-intro">{intro}</p>
        </div>

        <div class="gal-head__tools">
          {/* 房间 / 网格：3D 挂不起来时脚本会把这两个按钮收掉 */}
          <div class="gal-views">
            <button class="gal-view" id="gal-mode-3d" type="button" aria-pressed="false">
              {t('gallery.roomMode')}
            </button>
            <button class="gal-view" id="gal-mode-grid" type="button" aria-pressed="true">
              {t('gallery.gridMode')}
            </button>
          </div>
          <a class="gal-view" href={backUrl}>{t('gallery.back')}</a>
        </div>
      </div>

      <p class="gal-fallback" id="gal-fallback" hidden>{t('gallery.fallback.notice')}</p>

      <GalleryFloor
        rooms={floorRooms}
        startRoomId={found.id}
        corridorLabel={t(`gallery.view.${found.view}`)}
        locale={locale}
      />
      <GalleryGrid groups={floorRooms} locale={locale} />
      <GalleryLightbox locale={locale} />
    </div>
  </Section>
</BaseLayout>
