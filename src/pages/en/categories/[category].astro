---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import PostList from '../../../components/PostList.astro';
import PostRedirect from '../../../components/PostRedirect.astro';
import { profile } from '../../../data/profile';
import { href, postsOf } from '../../../lib/posts';
import { categoryLabel, legacyTermRoutes, orderedCategories } from '../../../lib/taxonomy';
import { toLocale, useTranslations, type Locale } from '../../../i18n/ui';

interface Props {
  locale: Locale;
  /** 词表里的分类 key（真页面才有） */
  key?: string;
  /** 有值 = 这一页是旧地址的跳转页，值是新地址（词条页根之下的路径，如 categories/tech） */
  redirect?: string;
}

/**
 * 与中文侧同构：分类的 key 中英共用（是 `tech` 不是 `Tech`），
 * 显示名按语言从词表取 —— 这样两版的地址是同一个，改显示名也不动地址。
 */
export async function getStaticPaths() {
  const locale = toLocale('en');

  const real = Object.keys(orderedCategories()).map((key) => ({
    params: { category: key },
    props: { locale, key },
  }));

  const legacy = legacyTermRoutes(locale, 'categories').map(({ from, to }) => ({
    params: { category: from },
    props: { locale, redirect: to },
  }));

  return [...real, ...legacy];
}

const { locale, key = '', redirect } = Astro.props;
const t = useTranslations(locale);
const p = profile[locale];

const label = redirect ? '' : categoryLabel(locale, key);
const posts = redirect ? [] : (await postsOf(locale)).filter((post) => post.data.category === key);

const title = `${t('category.label')}: ${label} · ${p.name}`;
---

{
  redirect ? (
    <PostRedirect
      title={`${t('category.label')} · ${p.name}`}
      href={href(locale, redirect)}
      locale={locale}
    />
  ) : (
    <BaseLayout profile={p} locale={locale} title={title} description={title} rail>
      <Section title={`${t('category.label')}: ${label}`} icon="📚">
        {/* 空分类不报「0 篇」：下面那句话已经说清了，两句都在说「没有」是废话。
            分类可以是空的：它是信息架构，先于文章存在，给一句话别让人以为页面坏了。 */}
        {posts.length === 0 ? (
          <p class="empty-hint">{t('category.empty')}</p>
        ) : (
          <>
            <p class="list-summary">
              {posts.length} {t('archive.count')}
            </p>
            <PostList posts={posts} locale={locale} />
          </>
        )}
      </Section>
    </BaseLayout>
  )
}
