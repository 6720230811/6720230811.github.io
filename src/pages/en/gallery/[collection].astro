---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GalleryShell from '../../../components/gallery/GalleryShell.astro';
import CollectionStream from '../../../components/gallery/CollectionStream.astro';
import GalleryLightbox from '../../../components/gallery/GalleryLightbox.astro';
import '../../../styles/gallery.css';
import '../../../styles/gallery-spread.css';
import '../../../styles/gallery-collections.css';
import { profile } from '../../../data/profile';
import { collectionById, collections, legacyRoutes } from '../../../data/gallery';
import { galleryNav, no2 } from '../../../lib/gallery/shell';
import { toLocale, useTranslations } from '../../../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

// Collection detail, photo stream: /en/gallery/<collection id>/
//
// The 2026-09-15 revision: **the URL decides the view.**
//   this page      — the photo stream (CollectionStream), reached from the
//                    Collections index by clicking a cover;
//   /rooms/<id>/   — the 3D hall (CollectionHall), reached from the 3D halls
//                    door row.
// Before, both views shared one URL and `mode` in meta.json picked between them,
// so clicking a cover from the index could drop you into a hall you had to drag
// around. `mode` now answers one question only: does this collection have a
// walkable hall? (if yes it appears on the door row and gets a /rooms/<id>/ URL).
// Both URLs come from collectionHref() in shell.ts.
//
// Legacy paths are handled here: the gallery changed its IA twice in 2026-09 and
// /gallery/theme-city/ style URLs have been live, so they must not 404.
interface PathProps {
  id: string;
  /**
   * Legacy path: when set, 301 instead of rendering. A path **relative to the
   * gallery root** (`night-walk/`, `rooms/night-walk/`), not a collection id —
   * the old `hall-<id>` URLs opened a 3D hall, so they go to the hall page.
   */
  redirectTo: string | null;
}

export function getStaticPaths() {
  const known = new Set(collections.map((collection) => collection.id));
  const paths: { params: { collection: string }; props: PathProps }[] = collections.map(
    (collection) => ({
      params: { collection: collection.id },
      props: { id: collection.id, redirectTo: null },
    })
  );

  for (const legacy of legacyRoutes()) {
    if (known.has(legacy.from)) continue;
    paths.push({
      params: { collection: legacy.from },
      props: { id: legacy.to, redirectTo: legacy.to },
    });
  }
  return paths;
}

const { id, redirectTo } = Astro.props as PathProps;

const locale = toLocale('en');
const t = useTranslations(locale);
const p = profile[locale];
const base = getRelativeLocaleUrl(locale, 'gallery');

if (redirectTo) return Astro.redirect(`${base}${redirectTo}`, 301);

const collection = collectionById(id);
if (!collection) return Astro.redirect(base, 302);

const index = collections.findIndex((item) => item.id === collection.id);

/** Left rail: this collection's photos, lighting up the matching plate */
const dirItems = collection.photos.map((photo, i) => ({
  id: photo.id,
  no: no2(i),
  name: photo.title[locale],
  sub: String(photo.year),
}));

const facts = [
  {
    k: t('gallery.meta.total'),
    v: `${collection.photos.length} ${t('gallery.itemCount')}`,
  },
  { k: t('gallery.meta.years'), v: collection.years },
  // This page is the stream; whether a hall exists is the door row's business
  { k: t('gallery.meta.mode'), v: t('gallery.mode.flat') },
];

const intro =
  collection.subtitle?.[locale] ??
  `${collection.photos.length} ${t('gallery.itemCount')} · ${collection.years}`;

const hero = collection.cover.src;
---

<BaseLayout
  profile={p}
  locale={locale}
  title={`${collection.title[locale]} · ${t('gallery.title')}`}
  description={collection.note?.[locale] ?? intro}
  hero="backdrop"
  heroImage={hero}
  heroHeight="13rem"
>
  <GalleryShell
    locale={locale}
    no={no2(index < 0 ? 0 : index)}
    name={collection.title[locale]}
    intro={intro}
    entries={galleryNav(locale, base)}
    dirTitle={t('gallery.dir.title')}
    dirItems={dirItems}
    noteTitle={t('gallery.note.title')}
    noteBody={collection.note?.[locale] ?? t('gallery.detail.noteFallback')}
    noteFacts={facts}
    noteGear={collection.gear}
    noteTags={collection.tags}
  >
    <CollectionStream photos={collection.photos} locale={locale} />
    <GalleryLightbox locale={locale} selector=".gal-plate__tile" />
  </GalleryShell>
</BaseLayout>

<script>
  import { initGalleryStudio } from '../../../lib/gallery/studio';
  initGalleryStudio();
</script>
