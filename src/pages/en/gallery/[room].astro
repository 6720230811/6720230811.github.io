---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import GalleryFloor from '../../../components/gallery/GalleryFloor.astro';
import GalleryGrid from '../../../components/gallery/GalleryGrid.astro';
import GalleryLightbox from '../../../components/gallery/GalleryLightbox.astro';
import '../../../styles/gallery.css';
import { profile } from '../../../data/profile';
import { roomById, roomLabel, roomNote, rooms } from '../../../data/gallery';
import { toLocale, useTranslations } from '../../../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

// 与中文房间页同一套做法，只是路径前缀是 /en/gallery/
export function getStaticPaths() {
  return [
    ...rooms('theme').map((room) => ({ params: { room: room.id }, props: { room } })),
    ...rooms('year').map((room) => ({ params: { room: room.id }, props: { room } })),
    ...rooms('hall').map((room) => ({ params: { room: room.id }, props: { room } })),
  ];
}

const { room } = Astro.props;

const locale = toLocale('en');
const t = useTranslations(locale);
const p = profile[locale];

const found = roomById(room.view, room.id);
if (!found) return Astro.redirect(getRelativeLocaleUrl(locale, 'gallery'));

const label = roomLabel(found, locale);

// 房间之间已经打通：这一页装的是同一策展视图下的整层展厅，只是从当前这间出生
const base = getRelativeLocaleUrl(locale, 'gallery');
const siblings = rooms(found.view);
const floorRooms = siblings.map((item) => ({
  id: item.id,
  label: roomLabel(item, locale),
  intro: `${item.items.length} ${t('gallery.itemCount')}`,
  style: item.style,
  items: item.items,
}));
const total = siblings.reduce((sum, item) => sum + item.items.length, 0);
const intro = `${siblings.length} ${t('gallery.roomCount')} · ${total} ${t('gallery.itemCount')}`;

// 回到同一策展的房间索引：按时间布展回 /en/gallery/year/，自由展厅回 /en/gallery/halls/
const indexUrl: Record<typeof found.view, string> = {
  theme: base,
  year: `${base}year/`,
  hall: `${base}halls/`,
};
---

<BaseLayout
  profile={p}
  locale={locale}
  title={`${label} · ${t('gallery.title')}`}
  description={intro}
>
  <Section title={label} titleId="gal-room-title" icon="🖼">
    <div class="gal-page" id="gal-page" data-mode="grid">
      <div class="gal-head">
        <div class="gal-head__title">
          <span class="gal-head__view">{t(`gallery.view.${found.view}`)}</span>
          <span class="gal-head__view">{t(`gallery.style.${found.style}`)}</span>
          <p class="gal-head__intro" id="gal-room-intro">{roomNote(found, locale) || intro}</p>
        </div>

        <div class="gal-head__tools">
          <div class="gal-views">
            <button class="gal-view" id="gal-mode-3d" type="button" aria-pressed="false">
              {t('gallery.roomMode')}
            </button>
            <button class="gal-view" id="gal-mode-grid" type="button" aria-pressed="true">
              {t('gallery.gridMode')}
            </button>
          </div>
          <a class="gal-view" href={indexUrl[found.view]}>{t('gallery.back')}</a>
        </div>
      </div>

      <p class="gal-fallback" id="gal-fallback" hidden>{t('gallery.fallback.notice')}</p>

      <GalleryFloor rooms={floorRooms} startRoomId={found.id} locale={locale} />
      <GalleryGrid groups={floorRooms} locale={locale} />
      <GalleryLightbox locale={locale} />
    </div>
  </Section>
</BaseLayout>
