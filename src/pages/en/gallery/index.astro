---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GalleryShell from '../../../components/gallery/GalleryShell.astro';
import CollectionIndex from '../../../components/gallery/CollectionIndex.astro';
import '../../../styles/gallery.css';
import '../../../styles/gallery-spread.css';
import '../../../styles/gallery-collections.css';
import { profile } from '../../../data/profile';
import { collections, galleryTotals } from '../../../data/gallery';
import { galleryNav, no2 } from '../../../lib/gallery/shell';
import { toLocale, useTranslations } from '../../../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

// Gallery landing page = the collection cover index (since 2026-09-15).
// Three deliberate choices:
//   1. It does NOT use the shared Section card: the page is a magazine spread
//      and borrows width from the gutters itself (see .gal-spread --bleed).
//   2. hero="backdrop" — a background-only band. The default banner would take
//      259px of document flow (--banner-h 315 − overlap 56 at a 900px viewport),
//      pushing the spread down and breaking the right rail's pet-clearance
//      anchor (rail bottom 723 overlapping the pet at 564). The backdrop keeps
//      the band behind the navbar without moving anything, which is also what
//      the navbar needed: it used to float on flat colour with no breathing room.
//      The image is the first collection's cover — the page's best face.
//   3. The body is CollectionIndex, the same component /gallery/rooms/ uses.
const locale = toLocale('en');
const t = useTranslations(locale);
const p = profile[locale];
const base = getRelativeLocaleUrl(locale, 'gallery');

/** Left rail: clicking a row goes straight into the collection */
const dirItems = collections.map((collection, index) => ({
  id: collection.id,
  no: no2(index),
  name: collection.title[locale],
  sub:
    collection.subtitle?.[locale] ??
    `${collection.photos.length} ${t('gallery.itemCount')}`,
  href: `${base}${collection.id}/`,
}));

const facts = [
  {
    k: t('gallery.meta.collections'),
    v: `${galleryTotals.collections} ${t('gallery.collectionUnit')}`,
  },
  { k: t('gallery.meta.photos'), v: `${galleryTotals.photos} ${t('gallery.itemCount')}` },
  { k: t('gallery.meta.years'), v: galleryTotals.years },
];

const hero = collections[0]?.cover.src ?? `${import.meta.env.BASE_URL}banner.jpg`;
---

<BaseLayout
  profile={p}
  locale={locale}
  title={`${t('gallery.title')} · ${p.name}`}
  description={t('gallery.spread.intro')}
  hero="backdrop"
  heroImage={hero}
  heroHeight="13rem"
>
  <GalleryShell
    locale={locale}
    no="01"
    name={t('gallery.nav.index')}
    intro={t('gallery.spread.intro')}
    entries={galleryNav(locale, base, 'index')}
    dirTitle={t('gallery.dir.title')}
    dirItems={dirItems}
    noteTitle={t('gallery.note.title')}
    noteBody={t('gallery.note.body')}
    noteFacts={facts}
    noteGear={galleryTotals.gear}
    noteTags={galleryTotals.tags.slice(0, 8)}
  >
    <CollectionIndex locale={locale} base={base} />
  </GalleryShell>
</BaseLayout>

<script>
  import { initGalleryStudio } from '../../../lib/gallery/studio';
  initGalleryStudio();
</script>
