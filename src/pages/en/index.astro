---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeBody from '../../components/HomeBody.astro';
import { profile } from '../../data/profile';
import { toLocale } from '../../i18n/ui';

// 英文版：对应路由 `/en/`（Astro.currentLocale 会自动解析为 'en'）
const locale = toLocale(Astro.currentLocale);
const p = profile[locale];

/**
 * 沉浸式门面：首屏由 BaseLayout 的 hero="immersive" 渲染（见 HomeHero.astro），
 * 这里只放首屏之下的内容区。
 *
 * title / description 与关于页**刻意不同**：
 *   - 关于页用「姓名 · 头衔」（改版前首页的原写法，保持既有收录）
 *   - 首页用「姓名 · 研究方向」，面向「这个人做什么」的检索意图
 * 研究方向直接取 profile.interests[0]，不另外维护一份文案 —— 与后台数据同源。
 *
 * description **不带 profile.title（学位）**，理由同中文版：首屏撤掉的身份信息
 * 不该又出现在搜索结果与分享卡片里。
 */
const focus = p.interests[0];
const title = focus ? `${p.name} · ${focus}` : p.name;
const description = p.interests.slice(0, 2).join(' · ');
---

<BaseLayout
  profile={p}
  locale={locale}
  title={title}
  description={description}
  hero="immersive"
>
  <HomeBody profile={p} locale={locale} />
</BaseLayout>
