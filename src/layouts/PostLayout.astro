---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import type { Post } from '../lib/posts';
import { categoryHref, formatDate, postHref, readingMinutes, tagHref } from '../lib/posts';
import { useTranslations, type Locale } from '../i18n/ui';
import type { Profile } from '../data/profile';
import { liftedImageCss, resolveCover } from '../lib/cover';

interface Props {
  entry: Post;
  locale: Locale;
  profile: Profile;
  headings: MarkdownHeading[];
  prev?: Post;
  next?: Post;
}

const { entry, locale, profile, headings, prev, next } = Astro.props;
const t = useTranslations(locale);
const { title, description, date, updated, category, tags } = entry.data;

const pageTitle = `${title} · ${profile.name}`;

// 有配图才在右侧开一栏；图来自正文时，正文里那张要隐掉，避免同一张图出现两次
const cover = resolveCover(entry);
const hideLiftedCss = liftedImageCss(cover);
---

<BaseLayout
  profile={profile}
  locale={locale}
  title={pageTitle}
  description={description}
  toc={headings}
>
  {/* data-pagefind-body：只有文章页带这个标记，pagefind 便只索引文章 */}
  <article class="section post" data-pagefind-body>
    {/* 图是从正文里提出来的：正文那张隐掉，只在右栏出现一次。
        选择器带 src，所以是逐页生成的一段 <style>，不走 Astro 的样式打包。 */}
    {hideLiftedCss && <Fragment set:html={`<style>${hideLiftedCss}</style>`} />}

    <header class="post__head">
      <h1 class="post__title">{title}</h1>
      <div class="post__meta">
        <time datetime={date.toISOString()}>{t('post.published')} {formatDate(date, locale)}</time>
        {
          updated && (
            <time datetime={updated.toISOString()}>
              {t('post.updated')} {formatDate(updated, locale)}
            </time>
          )
        }
        <a href={categoryHref(locale, category)}>{category}</a>
        <span>{readingMinutes(entry)} {t('post.minRead')}</span>
      </div>
      {
        tags.length > 0 && (
          <div class="tag-list">
            {tags.map((tag) => (
              <a class="tag" href={tagHref(locale, tag)}>
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class:list={['post__body', { 'post__body--split': !!cover }]}>
      <div class="prose">
        <slot />
      </div>

      {cover && (
        <aside class="post__aside">
          <figure class="post__figure">
            <img src={cover.src} alt={cover.alt} loading="lazy" decoding="async" />
          </figure>
        </aside>
      )}
    </div>

    {
      (prev || next) && (
        <nav class="post-nav" aria-label={t('nav.aria')}>
          {prev ? (
            <a class="post-nav__item" href={postHref(locale, prev.slug)}>
              <span class="post-nav__label">← {t('post.prev')}</span>
              <span class="post-nav__title">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a class="post-nav__item post-nav__item--next" href={postHref(locale, next.slug)}>
              <span class="post-nav__label">{t('post.next')} →</span>
              <span class="post-nav__title">{next.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
