---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import type { Post } from '../lib/posts';
import { categoryHref, formatDate, postHref, readingMinutes, tagHref } from '../lib/posts';
import { useTranslations, type Locale } from '../i18n/ui';
import type { Profile } from '../data/profile';

interface Props {
  entry: Post;
  locale: Locale;
  profile: Profile;
  headings: MarkdownHeading[];
  prev?: Post;
  next?: Post;
}

const { entry, locale, profile, headings, prev, next } = Astro.props;
const t = useTranslations(locale);
const { title, description, date, updated, category, tags } = entry.data;

const pageTitle = `${title} · ${profile.name}`;
---

<BaseLayout
  profile={profile}
  locale={locale}
  title={pageTitle}
  description={description}
  toc={headings}
>
  {/* data-pagefind-body：只有文章页带这个标记，pagefind 便只索引文章 */}
  <article class="section post" data-pagefind-body>
    <header class="post__head">
      <h1 class="post__title">{title}</h1>
      <div class="post__meta">
        <time datetime={date.toISOString()}>{t('post.published')} {formatDate(date, locale)}</time>
        {
          updated && (
            <time datetime={updated.toISOString()}>
              {t('post.updated')} {formatDate(updated, locale)}
            </time>
          )
        }
        <a href={categoryHref(locale, category)}>{category}</a>
        <span>{readingMinutes(entry)} {t('post.minRead')}</span>
      </div>
      {
        tags.length > 0 && (
          <div class="tag-list">
            {tags.map((tag) => (
              <a class="tag" href={tagHref(locale, tag)}>
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>

    {
      (prev || next) && (
        <nav class="post-nav" aria-label={t('nav.aria')}>
          {prev ? (
            <a class="post-nav__item" href={postHref(locale, prev.slug)}>
              <span class="post-nav__label">← {t('post.prev')}</span>
              <span class="post-nav__title">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a class="post-nav__item post-nav__item--next" href={postHref(locale, next.slug)}>
              <span class="post-nav__label">{t('post.next')} →</span>
              <span class="post-nav__title">{next.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
