---
import type { MarkdownHeading } from 'astro';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Backdrop from '../components/Backdrop.astro';
import NavProgress from '../components/NavProgress.astro';
import Sidebar from '../components/Sidebar.astro';
import Toc from '../components/Toc.astro';
import type { Profile } from '../data/profile';
import type { Locale } from '../i18n/ui';
import { ClientRouter } from 'astro:transitions';
import { visibleSections } from '../data/sections';
import { useTranslations } from '../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  profile: Profile;
  locale: Locale;
  title: string;
  description: string;
  /**
   * 右侧目录：
   * - 'sections'：About 页，目录列出正文板块
   * - MarkdownHeading[]：文章页，目录列出正文的二三级标题
   * - 省略：不显示目录（列表页、归档页等）
   */
  toc?: 'sections' | MarkdownHeading[];
  /**
   * 左侧个人信息卡（头像 / 姓名 / 简介 / 联系）只在首页出现。
   * 其它页面不需要它 —— 关掉之后主体是单列，横向更宽（画廊画布也跟着变大）。
   */
  showSidebar?: boolean;
  /**
   * canonical 地址：同一批内容有几种翻法时（如归档 / 分类 / 标签），
   * 指向最通用的那个页面，免得被当成几篇重复内容。传站内路径即可。
   */
  canonical?: string;
}

const { profile, locale, title, description, toc, showSidebar = false, canonical } = Astro.props;
const base = import.meta.env.BASE_URL;
const t = useTranslations(locale);

// 双语 SEO：标注两种语言的互链关系
const siteOrigin = Astro.site?.origin;
const zhAbs = siteOrigin ? new URL(getRelativeLocaleUrl('zh'), siteOrigin).toString() : undefined;
const enAbs = siteOrigin ? new URL(getRelativeLocaleUrl('en'), siteOrigin).toString() : undefined;

// 目录条目要在渲染前翻译好：SectionDef 里只有 i18n key
const sectionItems = visibleSections(profile).map((s) => ({ id: s.id, text: t(s.key) }));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    {/* canonical 尽量给绝对地址；没有配 site 时退回站内路径 */}
    {canonical && <link rel="canonical" href={siteOrigin ? new URL(canonical, siteOrigin).toString() : base + canonical.replace(/^\//, '')} />}

    {/* 站内跳转走 View Transitions：换掉 body 而不是整页刷新，不再白屏一下。
        fallback="none"：不要 Astro 自带的淡入淡出，方向由下面这段脚本定，
        动画交给 CSS（见 global.css 的 nav-enter），各浏览器表现一致。 */}
    <ClientRouter fallback="none" />

    {/* 必须在样式生效前定好 data-theme，否则会闪一下亮色。
        localStorage 里没有选择时跟随系统；禁用 JS 时固定亮色。
        data-astro-rerun：换页时 <html> 的属性会被新文档覆盖，主题得重新贴一次。 */}
    <script is:inline data-astro-rerun>
      try {
        var saved = localStorage.getItem('theme');
        if (saved !== 'dark' && saved !== 'light') {
          saved = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = saved;
      } catch (e) {
        document.documentElement.dataset.theme = 'light';
      }
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- 双语互链，便于搜索引擎正确收录对应语言版本 -->
    {zhAbs && <link rel="alternate" hreflang="zh" href={zhAbs} />}
    {enAbs && <link rel="alternate" hreflang="en" href={enAbs} />}
  </head>

  <body id="top">
    {/* 背景效果层：装饰性画布，靠 z-index 与 DOM 顺序压在所有内容之下 */}
    <Backdrop />

    <Navbar locale={locale} />
    <NavProgress locale={locale} />

    <script>
      /**
       * 换页方向：Astro 自己会标 data-astro-transition，但 push 跳转一律算 forward，
       * 从文章退回列表也照样「往前」，看着别扭。这里按地址深浅再判一次，
       * 写进新文档的 <html>（换页时 <html> 的属性会被新文档覆盖，只有写在
       * newDocument 上才留得下来），CSS 据此选动画：
       * 进更深的页面（列表 → 正文）从下方浮上来，退回浅的从上方落下来，深度相同只淡入。
       */
      document.addEventListener('astro:before-swap', (e) => {
        const depth = (url: URL) => url.pathname.split('/').filter(Boolean).length;
        const from = depth(e.from);
        const to = depth(e.to);
        const nav =
          e.direction === 'back' || to < from ? 'back' : to > from ? 'forward' : 'fade';
        e.newDocument.documentElement.dataset.nav = nav;
      });
    </script>

    {/* 装饰性横幅，下方 .page 会盖住它的底部 --banner-overlap */}
    <div class="hero" aria-hidden="true" style={`--banner-img: url('${base}banner.jpg')`}></div>

    <div class:list={['page', { 'page--full': !showSidebar }]}>
      <div class:list={['layout', { 'layout--full': !showSidebar }]}>
        {showSidebar && <Sidebar profile={profile} locale={locale} />}
        <main class="main">
          <slot />
        </main>
      </div>

      {/* 右侧目录：只在超宽屏显示（见 global.css 的 1536px 断点） */}
      {
        toc === 'sections' ? (
          <Toc locale={locale} mode="sections" items={sectionItems} />
        ) : toc ? (
          <Toc locale={locale} mode="headings" headings={toc} />
        ) : null
      }
    </div>

    <footer class="footer">
      <div>
        © {new Date().getFullYear()} {profile.name}
      </div>
    </footer>
  </body>
</html>
