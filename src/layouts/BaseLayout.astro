---
import type { MarkdownHeading } from 'astro';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Backdrop from '../components/Backdrop.astro';
import NavProgress from '../components/NavProgress.astro';
import Sidebar from '../components/Sidebar.astro';
import Toc from '../components/Toc.astro';
import Rail from '../components/Rail.astro';
import Pet from '../components/Pet.astro';
import { DEFAULT_CHARACTER } from '../data/pet';
import type { Profile } from '../data/profile';
import type { Locale } from '../i18n/ui';
import { ClientRouter } from 'astro:transitions';
import { visibleSections } from '../data/sections';
import { useTranslations } from '../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  profile: Profile;
  locale: Locale;
  title: string;
  description: string;
  /**
   * 右侧目录：
   * - 'sections'：About 页，目录列出正文板块
   * - MarkdownHeading[]：文章页，目录列出正文的二三级标题
   * - 省略：不显示目录（列表页、归档页等）
   */
  toc?: 'sections' | MarkdownHeading[];
  /**
   * 左侧个人信息卡（头像 / 姓名 / 简介 / 联系）只在首页出现。
   * 其它页面不需要它 —— 关掉之后主体是单列，横向更宽（画廊画布也跟着变大）。
   */
  showSidebar?: boolean;
  /**
   * canonical 地址：同一批内容有几种翻法时（如归档 / 分类 / 标签），
   * 指向最通用的那个页面，免得被当成几篇重复内容。传站内路径即可。
   */
  canonical?: string;
  /**
   * 左侧小挂件栏（迷你资料卡 / 写作足迹 / 本站速览 / 随便看看）。
   * 只在文章页开：它在 1536px 以下整栏隐藏，纯属"外围锦上添花"。
   */
  rail?: boolean;
}

const {
  profile,
  locale,
  title,
  description,
  toc,
  showSidebar = false,
  canonical,
  rail = false,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const t = useTranslations(locale);

// 双语 SEO：标注两种语言的互链关系
const siteOrigin = Astro.site?.origin;
const zhAbs = siteOrigin ? new URL(getRelativeLocaleUrl('zh'), siteOrigin).toString() : undefined;
const enAbs = siteOrigin ? new URL(getRelativeLocaleUrl('en'), siteOrigin).toString() : undefined;

// 目录条目要在渲染前翻译好：SectionDef 里只有 i18n key
const sectionItems = visibleSections(profile).map((s) => ({ id: s.id, text: t(s.key) }));
---

<!doctype html>
<html lang={locale} data-pet-character={DEFAULT_CHARACTER}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    {/* canonical 尽量给绝对地址；没有配 site 时退回站内路径 */}
    {canonical && <link rel="canonical" href={siteOrigin ? new URL(canonical, siteOrigin).toString() : base + canonical.replace(/^\//, '')} />}

    {/* 站内跳转走 View Transitions：换掉 body 而不是整页刷新，不再白屏一下。
        fallback="swap"：不要 Astro 自带的淡入淡出（方向由下面这段脚本定，动画交给
        CSS 的 nav-enter / nav-leave）。不用 "none" 是因为那样不支持 View Transitions
        的浏览器会彻底不做站内跳转、退回整页刷新。 */}
    <ClientRouter fallback="swap" />

    {/* 必须在样式生效前定好 data-theme，否则会闪一下亮色。
        localStorage 里没有选择时跟随系统；禁用 JS 时固定亮色。
        data-astro-rerun：换页时 <html> 的属性会被新文档覆盖，主题得重新贴一次。 */}
    <script is:inline data-astro-rerun>
      try {
        var saved = localStorage.getItem('theme');
        if (saved !== 'dark' && saved !== 'light') {
          saved = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = saved;
      } catch (e) {
        document.documentElement.dataset.theme = 'light';
      }
    </script>

    {/* 同一个道理：宠物选的是哪只，也得在样式生效前贴到 <html> 上。
        角色存在 localStorage，而页面是**构建期渲染**的，HTML 里只可能是默认角色 ——
        不在这里补一次，选了涅普顿的人会先看到布兰、再跳一下色。

        默认值来自 <html> 上那个构建期写好的 data-pet-character，所以这里
        **只在 localStorage 有值时覆盖**，读不到（没选过 / 无痕模式）就什么都不做。

        键名 'pet_v1' 与 src/lib/pet/state.ts 的 PET_KEY 相同 —— 改一处要改两处，
        那边有互指的注释。真要让脚本去 import 常量的话，它就不再是最小的内联脚本了，
        而这段必须阻塞渲染、越早跑越好。 */}
    <script is:inline data-astro-rerun>
      try {
        var petRaw = localStorage.getItem('pet_v1');
        var petId = petRaw ? JSON.parse(petRaw).character : '';
        if (typeof petId === 'string' && petId) {
          document.documentElement.dataset.petCharacter = petId;
        }
      } catch (e) {
        // 读不出来就保持构建期那个默认角色，别覆盖
      }
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- 双语互链，便于搜索引擎正确收录对应语言版本 -->
    {zhAbs && <link rel="alternate" hreflang="zh" href={zhAbs} />}
    {enAbs && <link rel="alternate" hreflang="en" href={enAbs} />}
  </head>

  <body id="top">
    {/* 背景效果层：装饰性画布，靠 z-index 与 DOM 顺序压在所有内容之下 */}
    <Backdrop />

    <Navbar locale={locale} />
    <NavProgress locale={locale} />

    <script>
      /**
       * 换页方向：Astro 自己会标 data-astro-transition，但 push 跳转一律算 forward，
       * 从文章退回列表也照样「往前」，看着别扭。这里按地址深浅再判一次。
       */
      const depth = (url: URL) => url.pathname.split('/').filter(Boolean).length;
      const directionOf = (from: URL, to: URL, given: string) =>
        given === 'back' || depth(to) < depth(from)
          ? 'back'
          : depth(to) > depth(from)
            ? 'forward'
            : 'fade';

      // 旧页面退场：给 <html> 打上 nav-leaving，由 CSS 放退场动画（见 global.css）。
      // 取新页面和放动画是同时进行的，等两份都好了再换，站着干等没必要。
      document.addEventListener('astro:before-preparation', (e) => {
        const root = document.documentElement;
        root.dataset.nav = directionOf(e.from, e.to, e.direction);
        root.classList.add('nav-leaving');

        const main = document.querySelector('.main');
        const leaving = main
          ? Promise.race([
              // getAnimations() 会先算一次样式，所以这里已经能拿到刚挂上的退场动画；
              // 关了动画偏好时拿不到动画，立刻放行
              Promise.all(main.getAnimations().map((a) => a.finished.catch(() => {}))),
              new Promise((resolve) => setTimeout(resolve, 400)),
            ])
          : Promise.resolve();

        // 跳转被打断（比如连着点了两个链接）时把标记撤掉，
        // 否则 .main 会停在退场动画的最后一帧，整页看不见
        e.signal.addEventListener('abort', () => root.classList.remove('nav-leaving'));

        const load = e.loader;
        e.loader = () => Promise.all([load(), leaving]).then(() => {});
      });

      // 新页面进场：方向要写进 newDocument 的 <html> —— 换页时当前 <html> 的
      // 属性会被新文档整个盖掉，只有写在新文档上才留得下来
      document.addEventListener('astro:before-swap', (e) => {
        e.newDocument.documentElement.dataset.nav = directionOf(e.from, e.to, e.direction);
      });
    </script>

    {/* 装饰性横幅，下方 .page 会盖住它的底部 --banner-overlap */}
    <div class="hero" aria-hidden="true" style={`--banner-img: url('${base}banner.jpg')`}></div>

    <div class:list={['page', { 'page--full': !showSidebar }]}>
      <div class:list={['layout', { 'layout--full': !showSidebar }]}>
        {showSidebar && <Sidebar profile={profile} locale={locale} />}
        <main class="main">
          <slot />
        </main>
      </div>

      {/* 右侧目录：只在超宽屏显示（见 global.css 的 1536px 断点） */}
      {
        toc === 'sections' ? (
          <Toc locale={locale} mode="sections" items={sectionItems} />
        ) : toc ? (
          <Toc locale={locale} mode="headings" headings={toc} />
        ) : null
      }

      {/* 左侧小挂件栏：与目录同一断点，只有文章页传了 rail 才出现 */}
      {rail && <Rail locale={locale} profile={profile} />}
    </div>

    <footer class="footer">
      <div>
        © {new Date().getFullYear()} {profile.name}
      </div>
    </footer>

    {/* 页面宠物：全站右下角浮动（含构建期生成的站内目录，供它本地检索） */}
    <Pet locale={locale} />
  </body>
</html>
