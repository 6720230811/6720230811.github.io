---
import type { MarkdownHeading } from 'astro';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Backdrop from '../components/Backdrop.astro';
import Sidebar from '../components/Sidebar.astro';
import Toc from '../components/Toc.astro';
import type { Profile } from '../data/profile';
import type { Locale } from '../i18n/ui';
import { visibleSections } from '../data/sections';
import { useTranslations } from '../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  profile: Profile;
  locale: Locale;
  title: string;
  description: string;
  /**
   * 右侧目录：
   * - 'sections'：About 页，目录列出正文板块
   * - MarkdownHeading[]：文章页，目录列出正文的二三级标题
   * - 省略：不显示目录（列表页、归档页等）
   */
  toc?: 'sections' | MarkdownHeading[];
}

const { profile, locale, title, description, toc } = Astro.props;
const base = import.meta.env.BASE_URL;
const t = useTranslations(locale);

// 双语 SEO：标注两种语言的互链关系
const siteOrigin = Astro.site?.origin;
const zhAbs = siteOrigin ? new URL(getRelativeLocaleUrl('zh'), siteOrigin).toString() : undefined;
const enAbs = siteOrigin ? new URL(getRelativeLocaleUrl('en'), siteOrigin).toString() : undefined;

// 目录条目要在渲染前翻译好：SectionDef 里只有 i18n key
const sectionItems = visibleSections(profile).map((s) => ({ id: s.id, text: t(s.key) }));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    {/* 必须在样式生效前定好 data-theme，否则会闪一下亮色。
        localStorage 里没有选择时跟随系统；禁用 JS 时固定亮色。 */}
    <script is:inline>
      try {
        var saved = localStorage.getItem('theme');
        if (saved !== 'dark' && saved !== 'light') {
          saved = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = saved;
      } catch (e) {
        document.documentElement.dataset.theme = 'light';
      }
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- 双语互链，便于搜索引擎正确收录对应语言版本 -->
    {zhAbs && <link rel="alternate" hreflang="zh" href={zhAbs} />}
    {enAbs && <link rel="alternate" hreflang="en" href={enAbs} />}
  </head>

  <body id="top">
    {/* 背景效果层：装饰性画布，靠 z-index 与 DOM 顺序压在所有内容之下 */}
    <Backdrop />

    <Navbar profile={profile} locale={locale} />

    {/* 装饰性横幅，下方 .page 会盖住它的底部 --banner-overlap */}
    <div class="hero" aria-hidden="true" style={`--banner-img: url('${base}banner.jpg')`}></div>

    <div class="page">
      <div class="layout">
        <Sidebar profile={profile} locale={locale} />
        <main class="main">
          <slot />
        </main>
      </div>

      {/* 右侧目录：只在超宽屏显示（见 global.css 的 1536px 断点） */}
      {
        toc === 'sections' ? (
          <Toc locale={locale} mode="sections" items={sectionItems} />
        ) : toc ? (
          <Toc locale={locale} mode="headings" headings={toc} />
        ) : null
      }
    </div>

    <footer class="footer">
      <div>
        © {new Date().getFullYear()} {profile.name}
      </div>
    </footer>
  </body>
</html>
