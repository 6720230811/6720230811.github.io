---
import type { Profile } from '../data/profile';
import { visibleSections } from '../data/sections';
import { useTranslations, type Locale } from '../i18n/ui';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  profile: Profile;
  locale: Locale;
}

const { profile, locale } = Astro.props;
const t = useTranslations(locale);

// 只列出内容非空的板块，锚点与正文一一对应
const items = visibleSections(profile);
---

<header class="navbar">
  <div class="navbar__inner">
    <a class="navbar__brand" href="#top">{profile.name}</a>

    <nav class="navbar__nav" aria-label={t('nav.aria')}>
      {items.map((s) => <a class="navbar__link" href={`#${s.id}`}>{t(s.key)}</a>)}
    </nav>

    <LangSwitcher />
  </div>
</header>

<script>
  // 滚动高亮：视口上部的窄带内、文档顺序最靠前的板块即为当前板块
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.navbar__link'));
  const sections = links
    .map((link) => document.getElementById(link.hash.slice(1)))
    .filter((el): el is HTMLElement => !!el);

  const setActive = (id: string) => {
    for (const link of links) {
      if (link.hash.slice(1) === id) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  };

  // 点击后立刻高亮，不等平滑滚动结束
  for (const link of links) {
    link.addEventListener('click', () => setActive(link.hash.slice(1)));
  }

  const inBand = new Set<string>();
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) inBand.add(entry.target.id);
        else inBand.delete(entry.target.id);
      }
      const current = sections.find((s) => inBand.has(s.id));
      if (current) setActive(current.id);
    },
    { rootMargin: '-20% 0px -70% 0px' }
  );

  for (const section of sections) observer.observe(section);
</script>
