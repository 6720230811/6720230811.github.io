---
import { navItems } from '../data/nav';
import { useTranslations, type Locale } from '../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Icon from './Icon.astro';
import Clock from './Clock.astro';
import LangSwitcher from './LangSwitcher.astro';
import Search from './Search.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// 导航项链接：getRelativeLocaleUrl 会补上语言前缀（/en/…）与 base 前缀
const links = navItems.map((item) => ({
  ...item,
  href: getRelativeLocaleUrl(locale, item.path),
}));

// 当前页高亮：去掉 base 与语言前缀后取路径首段（首页是空串）。
// getRelativeLocaleUrl(locale, '') 给出语言根（`/` 或 `/en/`，已含 base），
// 直接拿它裁一刀，就不必自己判断语言前缀了。
const localeRoot = getRelativeLocaleUrl(locale, '');
const fullPath = Astro.url.pathname;
const rest = fullPath.startsWith(localeRoot) ? fullPath.slice(localeRoot.length) : fullPath;
const current = rest.split('/').filter(Boolean)[0] ?? '';
const isCurrent = (path: string) => current === path;
---

<header class="navbar">
  <div class="navbar__card">
    {/* 左侧：时间与位置组件（原品牌位） */}
    <Clock locale={locale} />

    <nav class="navbar__nav" aria-label={t('nav.aria')}>
      {
        links.map((item) => (
          <a
            class="navbar__link"
            href={item.href}
            aria-current={isCurrent(item.path) ? 'page' : undefined}
          >
            {t(item.key)}
          </a>
        ))
      }
    </nav>

    <div class="navbar__tools">
      <Search locale={locale} />
      <ThemeToggle locale={locale} />
      <LangSwitcher />
      <button
        class="navbar__menu"
        type="button"
        id="nav-menu-switch"
        aria-label={t('nav.menu')}
        aria-expanded="false"
        aria-controls="nav-menu-panel"
      >
        <Icon name="menu" />
      </button>
    </div>

    {/* 窄屏下拉面板：结构与 Fuwari 的 NavMenuPanel 一致 */}
    <nav class="float-panel float-panel--closed" id="nav-menu-panel" aria-label={t('nav.aria')}>
      {
        links.map((item) => (
          <a
            class="nav-menu__link"
            href={item.href}
            aria-current={isCurrent(item.path) ? 'page' : undefined}
          >
            <span class="nav-menu__text">{t(item.key)}</span>
            <Icon name="chevron-right" />
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  // 窄屏导航菜单的开合
  const menuBtn = document.getElementById('nav-menu-switch');
  const menuPanel = document.getElementById('nav-menu-panel');

  const setMenu = (open: boolean) => {
    menuPanel?.classList.toggle('float-panel--closed', !open);
    menuBtn?.setAttribute('aria-expanded', String(open));
  };

  menuBtn?.addEventListener('click', () => {
    setMenu(menuPanel?.classList.contains('float-panel--closed') ?? false);
  });

  // 选中某一项后收起菜单
  for (const link of menuPanel?.querySelectorAll('a') ?? []) {
    link.addEventListener('click', () => setMenu(false));
  }
</script>
