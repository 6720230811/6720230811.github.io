---
import type { Profile } from '../data/profile';
import { visibleSections } from '../data/sections';
import { useTranslations, type Locale } from '../i18n/ui';
import Icon from './Icon.astro';
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  profile: Profile;
  locale: Locale;
}

const { profile, locale } = Astro.props;
const t = useTranslations(locale);

// 只列出内容非空的板块，锚点与正文一一对应
const items = visibleSections(profile);
---

<header class="navbar">
  <div class="navbar__card">
    <div class="navbar__inner">
      <a class="navbar__brand" href="#top">
        <Icon name="home" />
        <span>{profile.name}</span>
      </a>

      <nav class="navbar__nav" aria-label={t('nav.aria')}>
        {items.map((s) => <a class="navbar__link nav-anchor" href={`#${s.id}`}>{t(s.key)}</a>)}
      </nav>

      <div class="navbar__tools">
        <ThemeToggle locale={locale} />
        <LangSwitcher />
        <button
          class="navbar__menu"
          type="button"
          id="nav-menu-switch"
          aria-label={t('nav.menu')}
          aria-expanded="false"
          aria-controls="nav-menu-panel"
        >
          <Icon name="menu" />
        </button>
      </div>
    </div>

    {/* 窄屏下拉面板：顶栏放不下链接时收进这里 */}
    <nav class="nav-menu nav-menu--closed" id="nav-menu-panel" aria-label={t('nav.aria')}>
      {
        items.map((s) => (
          <a class="nav-menu__link nav-anchor" href={`#${s.id}`}>
            {t(s.key)}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  // 滚动高亮：视口上部的窄带内、文档顺序最靠前的板块即为当前板块。
  // 顶栏 / 侧栏导航卡 / 右侧目录 / 窄屏菜单四处锚点共用 .nav-anchor，会同步高亮。
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-anchor'));
  // sections 按 DOM 顺序独立取，不从 links 反推（否则某一处多一个锚点就会错位）
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.section[id]'));

  const setActive = (id: string) => {
    for (const link of links) {
      if (link.hash.slice(1) === id) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  };

  // 点击后立刻高亮，不等平滑滚动结束
  for (const link of links) {
    link.addEventListener('click', () => setActive(link.hash.slice(1)));
  }

  const inBand = new Set<string>();
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) inBand.add(entry.target.id);
        else inBand.delete(entry.target.id);
      }
      const current = sections.find((s) => inBand.has(s.id));
      // 都不在带内时保留上一次结果，避免高亮闪断
      if (current) setActive(current.id);
    },
    { rootMargin: '-20% 0px -60% 0px' }
  );

  for (const section of sections) observer.observe(section);

  // 窄屏导航菜单的开合
  const menuBtn = document.getElementById('nav-menu-switch');
  const menuPanel = document.getElementById('nav-menu-panel');

  const setMenu = (open: boolean) => {
    menuPanel?.classList.toggle('nav-menu--closed', !open);
    menuBtn?.setAttribute('aria-expanded', String(open));
  };

  menuBtn?.addEventListener('click', () => {
    setMenu(menuPanel?.classList.contains('nav-menu--closed') ?? false);
  });

  // 选中某一项后收起菜单
  for (const link of menuPanel?.querySelectorAll('a') ?? []) {
    link.addEventListener('click', () => setMenu(false));
  }
</script>
