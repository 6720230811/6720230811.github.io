---
/**
 * 背景效果层：一块固定画布 + 一层噪点，压在正文之下、顶部横幅之上
 * （层级、配色、噪点见 global.css 的 .backdrop / .backdrop-grain）
 *
 * 效果由五团柔光叠出来：
 *   1. 两团极淡的环境光，始终按李萨如曲线缓慢漂移 —— 页面静止时也有呼吸感
 *   2. 三团跟随光标的柔光，跟随速度各不相同，移动时拖出层次分明的尾迹
 *   3. 呼吸：每团的半径与透明度按各自周期轻微起伏
 *   4. 速度感应：光标划得越快，光晕越大越亮，停下后缓缓收回
 *   5. 进场淡入；鼠标移出窗口后交还给自动漂移
 */
---

{/* 纯装饰：对读屏器隐藏，也不接收鼠标事件 */}
<canvas id="backdrop" class="backdrop" aria-hidden="true"></canvas>
<div class="backdrop-grain" aria-hidden="true"></div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('#backdrop');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    type RGB = [number, number, number];

    /** 配色写在 CSS 变量里（明暗主题各一套），这里按效果给透明度 */
    let c1: RGB = [37, 99, 235]; // 主光
    let c2: RGB = [139, 92, 246]; // 副光
    let c3: RGB = [13, 148, 136]; // 第三层，偏青，和主色拉开层次

    const parse = (value: string, fallback: RGB): RGB => {
      const parts = value.trim().split(/\s+/).map(Number);
      return parts.length === 3 && parts.every((n) => Number.isFinite(n))
        ? (parts as RGB)
        : fallback;
    };

    const readPalette = () => {
      const style = getComputedStyle(canvas);
      c1 = parse(style.getPropertyValue('--bd-1'), c1);
      c2 = parse(style.getPropertyValue('--bd-2'), c2);
      c3 = parse(style.getPropertyValue('--bd-3'), c3);
    };
    readPalette();
    // 主题切换后变量值会变，重新读一次
    new MutationObserver(readPalette).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    const rgba = (c: RGB, alpha: number) => `rgb(${c[0]} ${c[1]} ${c[2]} / ${alpha})`;

    // ---------- 画布尺寸 ----------
    // 半分辨率渲染再拉满：柔光本来就没有细节，省下 3/4 的填充量，
    // 放大时的插值还能让渐变更顺滑（半分辨率的色带由噪点层压掉）
    const RES = 0.5;
    let w = 0;
    let h = 0;

    const resize = () => {
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = Math.max(1, Math.round(w * RES));
      canvas.height = Math.max(1, Math.round(h * RES));
      ctx.setTransform(RES, 0, 0, RES, 0, 0);
    };
    resize();
    window.addEventListener('resize', resize);

    // ---------- 光标 ----------
    const target = { x: w / 2, y: h * 0.4 };
    let engaged = false; // 用户是否动过鼠标

    const onPoint = (e: PointerEvent) => {
      target.x = e.clientX;
      target.y = e.clientY;
      engaged = true;
    };
    window.addEventListener('pointermove', onPoint, { passive: true });
    window.addEventListener('pointerdown', onPoint, { passive: true });
    // 鼠标移出窗口：交还给自动漂移
    document.addEventListener('pointerleave', () => {
      engaged = false;
    });

    // ---------- 五团柔光 ----------
    interface Orb {
      x: number;
      y: number;
      /** 跟随速度，越小拖得越长 */
      lag: number;
      /** 半径（相对 base） */
      r: number;
      alpha: number;
      /** 呼吸相位，避免所有层同步起伏 */
      phase: number;
      color: () => RGB;
    }

    interface Ambient {
      /** 漂移幅度（相对视口宽高）与速度 */
      ax: number;
      ay: number;
      sx: number;
      sy: number;
      r: number;
      alpha: number;
      phase: number;
      color: () => RGB;
    }

    const orbSpecs: Omit<Orb, 'x' | 'y'>[] = [
      { lag: 0.14, r: 0.34, alpha: 0.3, phase: 0, color: () => c1 },
      { lag: 0.085, r: 0.52, alpha: 0.22, phase: 2.1, color: () => c2 },
      { lag: 0.05, r: 0.78, alpha: 0.14, phase: 4.3, color: () => c3 },
    ];

    // 环境光：不跟光标，自己在整页里游走，避免画面大片死寂
    const ambient: Ambient[] = [
      { ax: 0.3, ay: 0.24, sx: 0.07, sy: 0.05, r: 0.9, alpha: 0.07, phase: 0, color: () => c1 },
      { ax: 0.26, ay: 0.3, sx: -0.05, sy: 0.08, r: 1, alpha: 0.06, phase: 2.4, color: () => c2 },
    ];

    const orbs: Orb[] = orbSpecs.map((o) => ({ ...o, x: target.x, y: target.y }));

    /** 画一团柔光：中间加一个色标，衰减比纯线性更自然 */
    const blob = (x: number, y: number, r: number, color: RGB, alpha: number) => {
      if (r <= 0 || alpha <= 0) return;
      const g = ctx.createRadialGradient(x, y, 0, x, y, r);
      g.addColorStop(0, rgba(color, alpha));
      g.addColorStop(0.45, rgba(color, alpha * 0.42));
      g.addColorStop(1, rgba(color, 0));
      ctx.fillStyle = g;
      // 只填这块圆的包围盒，不用整屏
      ctx.fillRect(x - r, y - r, r * 2, r * 2);
    };

    const render = (t: number, intro: number, boost: number) => {
      ctx.clearRect(0, 0, w, h);
      const base = Math.hypot(w, h) * 0.45;

      for (const a of ambient) {
        const x = w * (0.5 + a.ax * Math.sin(t * a.sx + a.phase));
        const y = h * (0.5 + a.ay * Math.cos(t * a.sy + a.phase * 1.7));
        const r = base * a.r * (1 + 0.08 * Math.sin(t * 0.5 + a.phase));
        blob(x, y, r, a.color(), a.alpha * intro);
      }

      for (const o of orbs) {
        o.x += (target.x - o.x) * o.lag;
        o.y += (target.y - o.y) * o.lag;
        // 呼吸 + 速度感应：划得越快，光晕越大越亮
        const r =
          base * o.r * (1 + 0.06 * Math.sin(t * 0.7 + o.phase)) * (1 + 0.18 * boost);
        blob(o.x, o.y, r, o.color(), o.alpha * (1 + 0.35 * boost) * intro);
      }
    };

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // 尊重系统的「减少动态效果」：只画一帧静态背景，不进动画循环
      render(0, 1, 0);
    } else {
      const t0 = performance.now();
      let energy = 0; // 平滑后的光标移动强度
      const prev = { x: target.x, y: target.y };

      const frame = (now: number) => {
        const t = (now - t0) / 1000;
        const intro = Math.min(t / 1.2, 1); // 进场淡入

        if (!engaged) {
          // 还没动过鼠标（触屏、或刚打开页面）时自己慢慢飘
          target.x = w * (0.5 + 0.28 * Math.sin(t * 0.23));
          target.y = h * (0.45 + 0.22 * Math.cos(t * 0.19));
        }

        const moved = Math.hypot(target.x - prev.x, target.y - prev.y);
        energy += (moved - energy) * 0.15;
        prev.x = target.x;
        prev.y = target.y;
        const boost = Math.min(energy / 22, 1);

        render(t, intro, boost);
        window.requestAnimationFrame(frame);
      };

      window.requestAnimationFrame(frame);
    }
  }
</script>
