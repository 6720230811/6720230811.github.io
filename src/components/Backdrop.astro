---
/**
 * 背景效果层：一块铺满视口的固定画布，压在正文之下、顶部横幅之上（见 global.css 的 .backdrop）
 *
 * 三种效果：
 *   glow   —— 光标处泛出一圈柔光，缓慢跟随
 *   dots   —— 点阵网格，靠近光标的点被推开、变亮（驱散感）
 *   aurora —— 几团彩色光斑缓慢漂移，并被光标吸引
 *
 * 切换方式：改下面的 BACKDROP_MODE；
 * 临时对比可以直接在地址栏加 ?bg=glow / ?bg=dots / ?bg=aurora（优先级更高）。
 */
const BACKDROP_MODE = 'glow'; // 'glow' | 'dots' | 'aurora'
---

{/* 纯装饰：对读屏器隐藏，也不接收鼠标事件 */}
<canvas id="backdrop" class="backdrop" data-mode={BACKDROP_MODE} aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('#backdrop');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const MODES = ['glow', 'dots', 'aurora'] as const;
    type Mode = (typeof MODES)[number];

    // 地址栏的 ?bg= 优先，方便不改代码直接对比三种效果
    const asked = new URLSearchParams(location.search).get('bg');
    const mode: Mode =
      MODES.find((m) => m === asked) ?? MODES.find((m) => m === canvas.dataset.mode) ?? 'glow';

    const TAU = Math.PI * 2;
    type RGB = [number, number, number];

    /**
     * 配色写在 CSS 变量里（见 .backdrop），明/暗主题各一套，
     * 这里按效果给透明度，主题切换后重新读一次。
     */
    let c1: RGB = [37, 99, 235]; // 主光
    let c2: RGB = [139, 92, 246]; // 副光
    let cDot: RGB = [139, 148, 158]; // 点阵常态色

    const parse = (value: string, fallback: RGB): RGB => {
      const parts = value.trim().split(/\s+/).map(Number);
      return parts.length === 3 && parts.every((n) => Number.isFinite(n)) ? (parts as RGB) : fallback;
    };

    const readPalette = () => {
      const style = getComputedStyle(canvas);
      c1 = parse(style.getPropertyValue('--bd-1'), c1);
      c2 = parse(style.getPropertyValue('--bd-2'), c2);
      cDot = parse(style.getPropertyValue('--bd-dot'), cDot);
    };
    readPalette();
    new MutationObserver(readPalette).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    const rgba = (c: RGB, alpha: number) => `rgb(${c[0]} ${c[1]} ${c[2]} / ${alpha})`;
    const mix = (a: RGB, b: RGB, t: number): RGB => [
      a[0] + (b[0] - a[0]) * t,
      a[1] + (b[1] - a[1]) * t,
      a[2] + (b[2] - a[2]) * t,
    ];

    // ---------- 画布尺寸 ----------
    let w = 0;
    let h = 0;

    const resize = () => {
      // 极光模式自带 CSS 模糊，1 倍分辨率就够，省一大截填充开销
      const dpr = mode === 'aurora' ? 1 : Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    window.addEventListener('resize', resize);

    // ---------- 光标位置：target 是真实位置，smooth 是缓慢跟上的位置 ----------
    const target = { x: w / 2, y: h * 0.4 };
    const smooth = { x: target.x, y: target.y };
    let engaged = false; // 用户是否动过鼠标

    const onPoint = (e: PointerEvent) => {
      target.x = e.clientX;
      target.y = e.clientY;
      engaged = true;
    };
    window.addEventListener('pointermove', onPoint, { passive: true });
    window.addEventListener('pointerdown', onPoint, { passive: true });

    // ---------- 效果一：光标柔光 ----------
    const drawGlow = () => {
      const r = Math.max(w, h) * 0.5;

      const main = ctx.createRadialGradient(smooth.x, smooth.y, 0, smooth.x, smooth.y, r);
      main.addColorStop(0, rgba(c1, 0.22));
      main.addColorStop(1, rgba(c1, 0));
      ctx.fillStyle = main;
      ctx.fillRect(0, 0, w, h);

      // 副色偏开一点，两团叠出渐变层次，不是单一色晕
      const ox = smooth.x - r * 0.35;
      const oy = smooth.y - r * 0.25;
      const sub = ctx.createRadialGradient(ox, oy, 0, ox, oy, r * 0.8);
      sub.addColorStop(0, rgba(c2, 0.16));
      sub.addColorStop(1, rgba(c2, 0));
      ctx.fillStyle = sub;
      ctx.fillRect(0, 0, w, h);
    };

    // ---------- 效果二：点阵驱散 ----------
    const drawDots = () => {
      const gap = 28; // 点距
      const reach = 160; // 影响半径
      const push = 18; // 最近处被推开的距离

      for (let x = gap / 2; x < w; x += gap) {
        for (let y = gap / 2; y < h; y += gap) {
          const dx = x - smooth.x;
          const dy = y - smooth.y;
          const d = Math.hypot(dx, dy);

          let ox = 0;
          let oy = 0;
          let alpha = 0.22;
          let radius = 1.1;
          let color = cDot;

          if (d < reach) {
            const k = 1 - d / reach; // 越靠近光标越接近 1
            const offset = k * k * push; // 平方衰减，边缘过渡更自然
            ox = (dx / (d || 1)) * offset;
            oy = (dy / (d || 1)) * offset;
            alpha = 0.22 + k * 0.78;
            radius = 1.1 + k * 1.3;
            color = mix(cDot, c1, Math.min(k * 1.6, 1)); // 近处染上主色
          }

          ctx.globalAlpha = alpha;
          ctx.fillStyle = rgba(color, 1);
          ctx.beginPath();
          ctx.arc(x + ox, y + oy, radius, 0, TAU);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
    };

    // ---------- 效果三：流动极光 ----------
    const blobs = Array.from({ length: 4 }, (_, i) => ({
      x: w * (0.2 + 0.2 * i),
      y: h * (0.3 + 0.18 * (i % 2)),
      vx: 0,
      vy: 0,
      r: Math.max(w, h) * (0.24 + 0.1 * (i % 2)),
      alt: i % 2 === 1, // 交替用主色 / 副色
      phase: i * 1.7, // 漂移相位，避免四团同步移动
    }));

    const drawAurora = (t: number, dt: number) => {
      for (const b of blobs) {
        // 朝光标缓慢聚拢，再叠一点自己的漂移，最后夹住边界
        b.vx += ((smooth.x - b.x) * 0.35 + Math.cos(t * 0.21 + b.phase) * 26) * dt;
        b.vy += ((smooth.y - b.y) * 0.35 + Math.sin(t * 0.17 + b.phase) * 26) * dt;
        b.vx *= 0.94;
        b.vy *= 0.94;
        b.x = Math.min(Math.max(b.x + b.vx * dt, 0), w);
        b.y = Math.min(Math.max(b.y + b.vy * dt, 0), h);

        const color = b.alt ? c2 : c1;
        const g = ctx.createRadialGradient(b.x, b.y, 0, b.x, b.y, b.r);
        g.addColorStop(0, rgba(color, 0.5));
        g.addColorStop(1, rgba(color, 0));
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, w, h);
      }
    };

    const draw = (t: number, dt: number) => {
      ctx.clearRect(0, 0, w, h);
      if (mode === 'dots') drawDots();
      else if (mode === 'aurora') drawAurora(t, dt);
      else drawGlow();
    };

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // 尊重系统的「减少动态效果」：只画一帧静态背景，不进入动画循环
      draw(0, 0);
    } else {
      let last = performance.now();

      const frame = (now: number) => {
        const dt = Math.min((now - last) / 1000, 0.05); // 切回标签页时别让 dt 爆掉
        last = now;
        const t = now / 1000;

        if (!engaged) {
          // 还没动过鼠标（触屏、或刚打开页面）时自己慢慢飘，画面不至于静止
          target.x = w * (0.5 + 0.26 * Math.sin(t * 0.23));
          target.y = h * (0.45 + 0.2 * Math.cos(t * 0.19));
        }

        // 缓慢跟随，光标停下时光晕还会飘一点才到位
        smooth.x += (target.x - smooth.x) * 0.07;
        smooth.y += (target.y - smooth.y) * 0.07;

        draw(t, dt);
        window.requestAnimationFrame(frame);
      };

      window.requestAnimationFrame(frame);
    }
  }
</script>
