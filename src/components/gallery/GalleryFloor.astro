---
import { mediaUrl, type GalleryItem } from '../../data/gallery';
import { useTranslations, type Locale } from '../../i18n/ui';
import type { HallStyleId } from '../../lib/gallery/styles';

/** 一间展室：id + 名字 + 形制 + 它自己的那批展品 */
export interface FloorRoom {
  id: string;
  label: string;
  intro: string;
  /** 形制：顶棚、材质、灯光都按它来 */
  style: HallStyleId;
  items: readonly GalleryItem[];
}

interface Props {
  /** 同一策展视图下的所有房间，会被摆进同一个连通的展厅 */
  rooms: readonly FloorRoom[];
  /** 从哪间房出生（就是当前这个页面的房间） */
  startRoomId: string;
  locale: Locale;
  /** 「离开展厅」回到哪个地址 */
  exitUrl: string;
}

const { rooms, startRoomId, locale, exitUrl } = Astro.props;
const t = useTranslations(locale);

/**
 * 只把渲染需要的最小字段交给脚本，不整份 schema 塞进 HTML。
 * （尺寸未知的先给 null，纹理载入后按真实宽高校正画框比例）
 */
const payload = rooms.map((room) => ({
  id: room.id,
  label: room.label,
  intro: room.intro,
  style: room.style,
  items: room.items.map((item) => ({
    id: item.id,
    type: item.type,
    src: mediaUrl(item.src),
    thumb: mediaUrl(item.thumb),
    w: item.w ?? null,
    h: item.h ?? null,
    title: item.title[locale],
    desc: item.desc?.[locale] ?? '',
    camera: item.camera ?? '',
    theme: item.theme,
    place: item.place ?? null,
  })),
}));
---

{/*
  3D 展厅的宿主。默认隐藏（.gal-page[data-mode='grid'] 里 display:none），
  脚本确认能用 WebGL 之后才把容器切到 data-mode='3d' 并挂载画布。
*/}
<div
  class="gal"
  id="gal"
  data-start-room={startRoomId}
  data-locale={locale}
  data-rooms={JSON.stringify(payload)}
  data-label-loading={t('gallery.loading')}
  data-label-camera={t('gallery.meta.camera')}
  data-label-hall={t('gallery.map.hall')}
  data-label-chapter={t('gallery.chapter')}
  data-label-intro={t('gallery.intro')}
>
  <canvas class="gal__canvas" id="gal-canvas" tabindex="0" aria-label={t('gallery.title')}></canvas>

  <div class="gal__progress" id="gal-progress" hidden><span></span></div>

  {/* 左上：章节编号 + 展区名称 */}
  <div class="gal__chapter" id="gal-chapter" hidden>
    <span class="gal__chapter-no" id="gal-chapter-no"></span>
    <span class="gal__chapter-name" id="gal-chapter-name"></span>
  </div>

  {/* 右上：可折叠小地图（点开是大地图，能传送） */}
  <div class="gal__mapbox" id="gal-mapbox">
    <button
      class="gal__chip"
      id="gal-map-toggle"
      type="button"
      aria-expanded="true"
      aria-controls="gal-minimap">{t('gallery.map.collapse')}</button
    >
    <button
      class="gal__minimap"
      id="gal-minimap"
      type="button"
      aria-expanded="false"
      aria-label={t('gallery.minimap')}
    >
      <canvas class="gal__minimap-canvas" id="gal-minimap-canvas"></canvas>
    </button>
  </div>

  {/* 左下：靠近作品时浮出作品信息 */}
  <figure class="gal__info" id="gal-info" aria-live="polite">
    <figcaption>
      <h3 class="gal__info-title" id="gal-info-title"></h3>
      <p class="gal__info-desc" id="gal-info-desc"></p>
      <small class="gal__info-meta" id="gal-info-meta"></small>
    </figcaption>
  </figure>

  {/* 右下：回正、地图、网格、退出 */}
  <div class="gal__tools">
    <button class="gal__btn" id="gal-reset" type="button">{t('gallery.reset')}</button>
    <button class="gal__btn" id="gal-grid" type="button" data-label-grid={t('gallery.gridMode')} data-label-room={t('gallery.roomMode')}>{t('gallery.gridMode')}</button>
    <button class="gal__btn" id="gal-immersive" type="button" aria-pressed="false" data-label-immersive={t('gallery.immersive')} data-label-exit={t('gallery.exit')}>{t('gallery.immersive')}</button>
    <a class="gal__btn gal__btn--link" id="gal-exit" href={exitUrl}>{t('gallery.leave')}</a>
  </div>

  {/* 首次进入的操作说明：5 秒后自己淡掉 */}
  <p class="gal__intro" id="gal-intro" role="note">
    <span id="gal-intro-text"></span>
  </p>

  {/* 大地图：点一下传送过去 */}
  <div class="gal__map" id="gal-map" hidden>
    <div class="gal__map-panel">
      <div class="gal__map-head">
        <h2 class="gal__map-title">{t('gallery.map.title')}</h2>
        <button class="gal__btn" id="gal-map-close" type="button">{t('gallery.close')}</button>
      </div>
      <canvas class="gal__map-canvas" id="gal-map-canvas" role="img" aria-label={t('gallery.map.title')}></canvas>
      <p class="gal__map-hint">{t('gallery.map.hint')}</p>
    </div>
  </div>

  {/* 走近看：DOM 浮层，文字比画进 3D 里清晰，键盘也能用 */}
  <div class="gal__focus" id="gal-focus" role="dialog" aria-modal="true" aria-label={t('gallery.title')}>
    <figure class="gal__figure">
      <img id="gal-focus-img" alt="" />
      <figcaption class="gal__caption">
        <h2 id="gal-focus-title"></h2>
        <p id="gal-focus-desc"></p>
        <small id="gal-focus-meta"></small>
      </figcaption>
      <div class="gal__nav">
        <button class="gal__btn" id="gal-focus-prev" type="button">{t('gallery.prev')}</button>
        <button class="gal__btn" id="gal-focus-next" type="button">{t('gallery.next')}</button>
        <button class="gal__btn" id="gal-focus-close" type="button">{t('gallery.close')}</button>
      </div>
    </figure>
  </div>
</div>

<script>
  import { mountGallery } from '../../lib/gallery';
  mountGallery(document.getElementById('gal'));
</script>
