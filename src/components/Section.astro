---
interface Props {
  id?: string;
  title: string;
  /** 可选的 emoji / 图标字符，如 '📝' */
  icon?: string;
}

const { id, title, icon } = Astro.props;
---

<section class="section" id={id}>
  <h2 class="section__title">
    {icon && <span class="icon">{icon}</span>}
    <span>{title}</span>
  </h2>
  <slot />
</section>
