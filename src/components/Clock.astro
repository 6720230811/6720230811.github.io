---
/**
 * 时间与位置组件：所在地 + 该地实时时间（顶栏右侧常驻）
 *
 * 站点是静态的，构建时算出的时间只能当占位，页面加载后由脚本接管、每秒刷新。
 */
import type { Profile } from '../data/profile';
import { useTranslations, type Locale } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  profile: Profile;
  locale: Locale;
}

const { profile, locale } = Astro.props;
const t = useTranslations(locale);

// hourCycle 而不是 hour12：后者的 h24 在午夜会输出「24:00」
const options: Intl.DateTimeFormatOptions = {
  timeZone: profile.timezone,
  hour: '2-digit',
  minute: '2-digit',
  second: '2-digit',
  hourCycle: 'h23',
};
const initial = new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-GB', options).format(
  new Date()
);
---

<div class="clock" data-tz={profile.timezone} data-lang={locale} title={t('clock.label')}>
  <Icon name="location" />
  <span class="clock__city">{profile.location}</span>
  <time class="clock__time">{initial}</time>
</div>

<script>
  const clock = document.querySelector<HTMLElement>('.clock');
  if (clock) {
    const timeEl = clock.querySelector('time');
    const fmt = new Intl.DateTimeFormat(clock.dataset.lang === 'en' ? 'en-GB' : 'zh-CN', {
      timeZone: clock.dataset.tz,
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hourCycle: 'h23',
    });

    const tick = () => {
      const now = new Date();
      if (timeEl) {
        timeEl.textContent = fmt.format(now);
        timeEl.dateTime = now.toISOString();
      }
    };

    tick();
    window.setInterval(tick, 1000);
  }
</script>
