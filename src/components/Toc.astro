---
import type { MarkdownHeading } from 'astro';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /**
   * sections：观察 About 页的 .section[id]（与正文板块一一对应）
   * headings：观察文章正文里的 h2/h3（由 Markdown 渲染结果给出）
   */
  mode: 'sections' | 'headings';
  items?: readonly { id: string; text: string }[];
  headings?: MarkdownHeading[];
}

const { locale, mode, items = [], headings = [] } = Astro.props;
const t = useTranslations(locale);

interface TocLink {
  id: string;
  text: string;
  /** 文章的 Markdown 标题有层级，三级标题缩进一格 */
  depth?: number;
}

// 目录条目：About 页用板块列表，文章页用正文的二三级标题（一级是文章标题本身）
const links: readonly TocLink[] =
  mode === 'sections'
    ? items
    : headings
        .filter((h) => h.depth === 2 || h.depth === 3)
        .map((h) => ({ id: h.slug, text: h.text, depth: h.depth }));
---

{
  links.length > 0 && (
    <aside class="toc" aria-label={t('toc.aria')}>
      <nav class="toc__inner">
        <div class="card__title">{t('widget.contents')}</div>
        <ul class="toc__list">
          {links.map((link) => (
            <li class={link.depth === 3 ? 'toc__item toc__item--sub' : 'toc__item'}>
              <a class="toc__link nav-anchor" href={`#${link.id}`}>
                {link.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  )
}

<script>
  /**
   * 滚动高亮：视口 30% 线以上、文档顺序里最后一个标题就是"正在读的那一节"
   * （规则与原因见 init 内的注释）。
   * 换页后 DOM 整批换掉，事件监听要清理，否则每次换页都会多挂一层，
   * 所以每次 astro:page-load 都要重来一遍，并在重来前清理上一个。
   */
  let cleanup: () => void = () => {};

  /**
   * 从链接的 hash 里取出目标 id。
   *
   * 必须 decodeURIComponent：a.hash 返回的是**序列化后**的片段，非 ASCII 会被百分号
   * 编码——`href="#原文"` 读出来是 `#%E5%8E%9F%E6%96%87`，拿它去和 DOM 里的 id（"原文"）
   * 比较永远不相等。这曾让中文标题的目录彻底不追踪（About 页 id 是英文，所以那边一直正常）。
   */
  const hashId = (link: HTMLAnchorElement): string => {
    const raw = link.hash.slice(1);
    try {
      return decodeURIComponent(raw);
    } catch {
      // 畸形片段（比如带裸 %）不该让整个目录挂掉
      return raw;
    }
  };

  const init = () => {
    cleanup();

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-anchor'));
    // 标题按 DOM 顺序独立取，不从 links 反推
    const targets = Array.from(
      document.querySelectorAll<HTMLElement>('.section[id], .prose [id]')
    );

    const setActive = (id: string) => {
      for (const link of links) {
        if (hashId(link) === id) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    };

    // 点击后立刻高亮，不等平滑滚动结束
    for (const link of links) {
      link.addEventListener('click', () => setActive(hashId(link)));
    }

    // 高亮按滚动位置判断，而不是 IntersectionObserver 的「命中带」：
    // 带内判断在页面底部会失效——最后几个标题根本滚不到那么高，永远进不了带，
    // 高亮会一直停在上一个（实测 6 个标题只能命中 4 个）。
    // 现在的规则：视口 30% 线以上的**最后一个**标题就是正在读的那一节。
    const LINE = 0.3;
    let raf = 0;
    const paint = () => {
      raf = 0;
      const line = window.innerHeight * LINE;
      // 已经滚到底：末尾那几个标题下面没有足够内容可滚，永远够不到判定线
      // （实测文末标题只到视口 471px 处），这时直接把高亮交给最后一个标题，
      // 否则读到文末高亮还停在上一节。
      const scrollable = document.documentElement.scrollHeight > window.innerHeight + 8;
      const atBottom =
        scrollable && window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 8;
      let current: HTMLElement | null = null;
      for (const t of targets) {
        if (atBottom || t.getBoundingClientRect().top <= line) current = t;
      }
      if (current) setActive(current.id);
    };
    const schedule = () => {
      if (!raf) raf = window.requestAnimationFrame(paint);
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    paint();

    cleanup = () => {
      window.removeEventListener('scroll', schedule);
      window.removeEventListener('resize', schedule);
      if (raf) window.cancelAnimationFrame(raf);
      raf = 0;
    };
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>
