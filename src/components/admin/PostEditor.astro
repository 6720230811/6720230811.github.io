---
import Icon from '../Icon.astro';

interface Props {
  id?: string;
}

const { id = 'post-preview' } = Astro.props;
---

<section class="panel">
  <div class="panel__head">
    <h2>文章</h2>
    <div class="panel__tools">
      <label class="inline">
        语言
        <select id="post-lang" class="input input--sm">
          <option value="zh">中文</option>
          <option value="en">English</option>
        </select>
      </label>
      <select id="post-file" class="input input--sm"></select>
      <button id="post-reload" class="btn" type="button">
        <Icon name="refresh" />
        重新载入
      </button>
      <button id="post-save" class="btn btn--primary" type="button">
        <Icon name="save" />
        发布
      </button>
    </div>
  </div>

  <p class="panel__hint">
    写回 <code id="post-path">src/content/posts/zh/</code>；发布后 Actions 会自动构建，大约 1 分钟后线上生效。
  </p>

  <div class="grid">
    <label class="field">
      <span class="field__label">
        <code>title</code>
        <span class="field__hint">标题</span>
      </span>
      <input id="post-title" class="input" type="text" spellcheck="false" />
    </label>

    <label class="field">
      <span class="field__label">
        <code>slug</code>
        <span class="field__hint">文件名，只能用小写字母/数字/连字符；新建时必填</span>
      </span>
      <input id="post-slug" class="input" type="text" spellcheck="false" placeholder="my-new-post" />
    </label>

    <label class="field">
      <span class="field__label">
        <code>date</code>
        <span class="field__hint">YYYY-MM-DD</span>
      </span>
      <input id="post-date" class="input" type="date" />
    </label>

    <label class="field">
      <span class="field__label">
        <code>category</code>
        <span class="field__hint">单个分类</span>
      </span>
      <input id="post-category" class="input" type="text" spellcheck="false" />
    </label>

    <label class="field">
      <span class="field__label">
        <code>tags</code>
        <span class="field__hint">逗号分隔</span>
      </span>
      <input id="post-tags" class="input" type="text" spellcheck="false" />
    </label>

    <label class="field">
      <span class="field__label">
        <code>cover</code>
        <span class="field__hint">封面图，站内绝对路径或外链；留空则用正文第一张图</span>
      </span>
      <div class="cover-field">
        <input
          id="post-cover"
          class="input"
          type="text"
          spellcheck="false"
          placeholder="/illustrations/xxx.png"
        />
        <div class="cover-field__preview">
          <img id="cover-thumb" class="cover-field__img" alt="" hidden />
          <p id="cover-hint" class="cover-field__hint" hidden></p>
        </div>
      </div>
    </label>

    <label class="field field--check">
      <input id="post-draft" type="checkbox" />
      <span><code>draft</code> 草稿（线上不显示）</span>
    </label>
  </div>

  <label class="field">
    <span class="field__label">
      <code>description</code>
      <span class="field__hint">列表页与搜索结果里显示的摘要</span>
    </span>
    <input id="post-desc" class="input" type="text" spellcheck="false" />
  </label>

  <div class="editor" data-view="body">
    <div class="editor__pane">
      <div class="editor__head">
        <div class="editor__label">Markdown 正文</div>
        <div id="post-stats" class="editor__stats"></div>
      </div>
      <p class="editor__tip">图片可以直接拖进来，或 Ctrl/Cmd+V 粘贴：会压到长边 1600px 转 WebP 后写进 public/illustrations/</p>

      {/* 工具栏按钮用文字符号，不新增图标：后台的 Icon 是 24×24 描边，做成小按钮并不清楚 */}
      <div class="md-tools" role="toolbar" aria-label="Markdown 工具">
        <button class="md-tools__btn" type="button" data-md="bold" title="加粗"><b>B</b></button>
        <button class="md-tools__btn" type="button" data-md="italic" title="斜体"><i>I</i></button>
        <button class="md-tools__btn" type="button" data-md="h2" title="标题">H</button>
        <button class="md-tools__btn" type="button" data-md="quote" title="引用">❝</button>
        <button class="md-tools__btn" type="button" data-md="ul" title="无序列表">•</button>
        <button class="md-tools__btn" type="button" data-md="ol" title="有序列表">1.</button>
        <button class="md-tools__btn" type="button" data-md="code" title="代码块">‹›</button>
        <button class="md-tools__btn" type="button" data-md="link" title="链接">🔗</button>
        <button class="md-tools__btn" type="button" data-md="image" title="图片">▣</button>
      </div>

      <textarea
        id="post-body"
        class="input input--code editor__area"
        spellcheck="false"
        placeholder="# 标题&#10;&#10;正文…"></textarea>
    </div>

    <div class="editor__pane">
      <div class="editor__head">
        <div class="editor__label">预览</div>
        <div class="view-switch" role="group" aria-label="预览视图">
          <button class="view-switch__btn" type="button" data-view="body" aria-pressed="true">正文</button>
          <button class="view-switch__btn" type="button" data-view="card" aria-pressed="false">列表卡片</button>
          <button class="view-switch__btn" type="button" data-view="head" aria-pressed="false">文章页</button>
        </div>
      </div>
      <iframe id={id} class="editor__preview" title="预览" sandbox="allow-same-origin"></iframe>
    </div>
  </div>

  <p class="field__error" id="post-error" hidden></p>
</section>
