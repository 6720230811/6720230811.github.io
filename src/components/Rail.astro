---
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import type { Profile } from '../data/profile';
import { postsOf, postHref, readingMinutes } from '../lib/posts';
import { resolveAvatar } from '../lib/avatar';
import { countContentLength } from '../lib/format';
import { getRelativeLocaleUrl } from 'astro:i18n';

/**
 * 左侧小挂件栏（文章页外围的那片空白）。
 *
 * 只放"锦上添花"的东西——它在 1536px 以下整个隐藏（和右侧 TOC 同一断点），
 * 窄屏读者看不到任何必要信息损失。
 *
 * 四个挂件全部是**构建时**算好的静态内容，没有运行时请求：
 *   ① 迷你资料卡：复用首页那张卡的数据，缩一版
 *   ② 写作足迹：近 12 周一天一格的热力图（数据就是文章日期）
 *   ③ 本站速览：篇数 / 字数 / 标签 / 摘录篇数与来源站数
 *   ④ 随便看看：点一下随机跳一篇（无 JS 时退化成构建时随机的那一篇）
 */
interface Props {
  locale: Locale;
  profile: Profile;
}

const { locale, profile } = Astro.props;
const t = useTranslations(locale);
const base = import.meta.env.BASE_URL;
const home = getRelativeLocaleUrl(locale);

const posts = await postsOf(locale);

// ---------------------------------------------------------------- 写作足迹（当月日历）
const DAY = 86_400_000;

const now = new Date();
// 全用 UTC 对齐：frontmatter 的日期是 UTC 零点（见 format.ts 的说明），
// 用本地时区算会差一天
const year = now.getUTCFullYear();
const month = now.getUTCMonth();
const firstUtc = Date.UTC(year, month, 1);
/** 下个月 0 号 = 本月最后一天，借它拿天数 */
const daysInMonth = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
const firstWeekday = (new Date(firstUtc).getUTCDay() + 6) % 7; // 周一记 0
const rowCount = Math.ceil((firstWeekday + daysInMonth) / 7);
/** 月初前面补空格，让列固定是周一到周日（和真实日历一样） */
const gridStartUtc = firstUtc - firstWeekday * DAY;

interface DayPost {
  title: string;
  href: string;
  minutes: number;
  category: string;
}

const byDay = new Map<string, DayPost[]>();
for (const post of posts) {
  const key = post.data.date.toISOString().slice(0, 10);
  const item: DayPost = {
    title: post.data.title,
    href: postHref(locale, post.slug),
    minutes: readingMinutes(post),
    category: post.data.category,
  };
  const list = byDay.get(key);
  if (list) list.push(item);
  else byDay.set(key, [item]);
}

const heatCells = Array.from({ length: rowCount * 7 }, (_, i) => {
  const utc = gridStartUtc + i * DAY;
  const date = new Date(utc);
  const key = date.toISOString().slice(0, 10);
  const dayPosts = byDay.get(key) ?? [];
  return {
    key,
    day: date.getUTCDate(),
    /** 月初/月末补齐的格子只是占位，不算内容也不显示日期 */
    inMonth: date.getUTCMonth() === month,
    posts: dayPosts,
    count: dayPosts.length,
    /** 同一天多篇时，格子指向最新那篇；悬停会把这一天全部列出来 */
    href: dayPosts[0]?.href,
  };
});

const monthPosts = heatCells.reduce((n, cell) => n + cell.count, 0);
/** 一天多篇的日子（点格子展开当天列表，而不是跳某一篇） */
const multiDays = heatCells.filter((cell) => cell.count > 1);
const monthLabel = new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-US', {
  year: 'numeric',
  month: 'long',
}).format(new Date(firstUtc));
const weekdays = Array.from({ length: 7 }, (_, i) =>
  new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-US', { weekday: 'narrow' }).format(
    new Date(gridStartUtc + i * DAY)
  )
);
// ---------------------------------------------------------------- 本站速览
const totalChars = posts.reduce((sum, p) => sum + countContentLength(p.body ?? ''), 0);
const charsLabel =
  locale === 'zh'
    ? totalChars >= 10_000
      ? `${(totalChars / 10_000).toFixed(1)} 万`
      : String(totalChars)
    : totalChars >= 1_000
      ? `${(totalChars / 1_000).toFixed(1)}k`
      : String(totalChars);

const tags = new Set<string>();
for (const post of posts) for (const tag of post.data.tags) tags.add(tag);

const collected = posts.filter((p) => p.data.source);
const sourceHosts = new Set<string>();
for (const post of collected) {
  try {
    sourceHosts.add(new URL(post.data.source ?? '').host);
  } catch {
    // source 写得不规范就忽略，别让侧栏整个挂掉
  }
}

// ---------------------------------------------------------------- 随便看看
const hrefs = posts.map((p) => postHref(locale, p.slug));
// 构建时先随机挑一篇：没有 JS 也能点，点了才有"再换一篇"的玩法
const fallbackHref = hrefs.length ? hrefs[Math.floor(Math.random() * hrefs.length)] : home;
---

<aside class="rail" aria-label={t('rail.aria')}>
  <div class="rail__inner">
    {/* ① 迷你资料卡 */}
    <div class="card rail__card mini-profile">
      <a class="mini-profile__avatar" href={`${home}#about`} tabindex="-1" aria-hidden="true">
        <img src={resolveAvatar(profile.avatar, base)} alt="" width="512" height="512" />
      </a>
      <div class="mini-profile__name">{profile.name}</div>
      <div class="mini-profile__title">{profile.title}</div>
      <div class="mini-profile__links">
        {
          (
            [
              ['GitHub', profile.links.github],
              ['Scholar', profile.links.scholar],
              ['LinkedIn', profile.links.linkedin],
              ['Blog', profile.links.blog],
            ] as const
          ).map(
            ([label, href]) =>
              href && (
                <a href={href} target="_blank" rel="noopener noreferrer">
                  {label}
                </a>
              )
          )
        }
      </div>
      <a class="mini-profile__more" href={`${home}#about`}>
        {t('rail.aboutMe')} →
      </a>
    </div>

    {/* ② 写作足迹 */}
    {
      (
        <div class="card rail__card">
          <div class="rail__title">{t('rail.footprint')}</div>
          <div class="heat">
            {/*
              信息条：默认显示本月概览；悬停某天时，那天的信息盖在它上面
              （不透明底 + 绝对定位到同一格，所以既不跳动也不闪烁）。
              横向一行排：日期 · 标题 · 分类 · 时长。
            */}
            <div class="heat__info">
              <span class="heat__info-default">
                <b>{monthLabel}</b>
                <span>
                  · {monthPosts} {t('rail.postsUnit')}
                </span>
              </span>

              {/*
                一天多篇时的当天列表：默认 hidden，点那天的格子才展开
                （单篇的日子不经过这里，直接跳文章）。字都在这块里，所以展开
                只会让卡片长高一点，不会动日历本身。
              */}
              {
                multiDays.map((cell) => (
                  <div class="heat__day" id={`heat-day-${cell.key}`} data-day={cell.key} hidden>
                    <span class="heat__day-head">
                      <b>{cell.key}</b>
                      <span class="heat__info-meta">
                        {cell.count} {t('rail.postsUnit')}
                      </span>
                    </span>
                    <ul class="heat__day-list">
                      {cell.posts.map((p) => (
                        /* 只放一行标题：栏宽只有 ~140px，带上分类/时长会折成两行，
                           展开时把日历往下顶太多。完整标题在 title 里 */
                        <li>
                          <a href={p.href} title={`${p.title} · ${p.category} · ${p.minutes} ${t('post.minRead')}`}>
                            {p.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </div>

            <div class="heat__head" aria-hidden="true">
              {weekdays.map((w) => (
                <span>{w}</span>
              ))}
            </div>

            <div class="heat__grid" aria-label={t('rail.footprintHint')}>
              {
                heatCells.map((cell) =>
                  cell.count > 1 ? (
                    /* 一天多篇：不跳某一篇，点开当天列表让读者自己挑
                       （无 JS 时它仍是普通链接，落到 href 那篇） */
                    <a
                      class="heat__cell heat__cell--multi"
                      href={cell.href}
                      data-day={cell.key}
                      aria-expanded="false"
                      aria-controls={`heat-day-${cell.key}`}
                      aria-label={`${cell.key} ${cell.count} ${t('rail.postsUnit')} ${t('rail.expandHint')}`}
                    >
                      {cell.day}
                      <span class="heat__info-item">
                        <b>{cell.key.slice(5)}</b>
                        <span class="heat__info-meta">
                          {[`${cell.count} ${t('rail.postsUnit')}`, t('rail.expandHint')].join(' · ')}
                        </span>
                        <span class="heat__info-title">{cell.posts[0].title}</span>
                      </span>
                    </a>
                  ) : cell.href ? (
                    /* 一天一篇：点进去，悬停/聚焦在信息条里显示详情 */
                    <a class="heat__cell" href={cell.href} aria-label={`${cell.key} ${cell.posts[0].title}`}>
                      {cell.day}
                      <span class="heat__info-item">
                        <b>{cell.key.slice(5)}</b>
                        <span class="heat__info-meta">
                          {[cell.posts[0].category, `${cell.posts[0].minutes} ${t('post.minRead')}`]
                            .filter(Boolean)
                            .join(' · ')}
                        </span>
                        <span class="heat__info-title">{cell.posts[0].title}</span>
                      </span>
                    </a>
                  ) : (
                    <span class:list={['heat__cell', { 'is-outside': !cell.inMonth }]}>
                      {cell.inMonth ? cell.day : ''}
                    </span>
                  )
                )
              }
            </div>
          </div>
        </div>
      )
    }


    {/* ③ 本站速览 */}
    <div class="card rail__card">
      <div class="rail__title">{t('rail.stats')}</div>
      <ul class="rail__stats">
        <li>
          <b>{posts.length}</b> {t('rail.postsUnit')}
        </li>
        <li>
          <b>{charsLabel}</b> {t('rail.charsUnit')}
        </li>
        <li>
          <b>{tags.size}</b> {t('rail.tagsUnit')}
        </li>
        {
          collected.length > 0 && (
            <li>
              <b>{collected.length}</b> {t('rail.collectedUnit')}
            </li>
          )
        }
        {
          sourceHosts.size > 0 && (
            <li>
              <b>{sourceHosts.size}</b> {t('rail.sourcesUnit')}
            </li>
          )
        }
      </ul>
    </div>

    {/* ④ 随便看看 */}
    {
      hrefs.length > 1 && (
        <a class="rail__random" id="rail-random" href={fallbackHref} data-hrefs={JSON.stringify(hrefs)}>
          <span aria-hidden="true">🎲</span> {t('rail.random')}
        </a>
      )
    }
  </div>
</aside>

<script>
  /**
   * 「随便看看」：把候选链接放在 data-hrefs 里，点击时随机挑一个。
   *
   * 用 <a> 而不是 <button>：没有 JS 时它就是一个正常的链接（指向构建时随机挑的那篇）。
   * 绑定打标记，避免 astro:page-load 首屏触发两次导致同一个元素绑两遍。
   */
  const initRandom = () => {
    const link = document.getElementById('rail-random');
    if (!link || link.dataset.bound === '1') return;
    link.dataset.bound = '1';
    link.addEventListener('click', (event) => {
      let hrefs: string[] = [];
      try {
        hrefs = JSON.parse(link.dataset.hrefs ?? '[]') as string[];
      } catch {
        return; // 解析不出来就让它走 href 里的兜底地址
      }
      if (hrefs.length < 2) return;
      // 尽量别跳到当前这篇
      const pool = hrefs.filter((h) => !location.pathname.startsWith(h));
      const list = pool.length ? pool : hrefs;
      event.preventDefault();
      location.href = list[Math.floor(Math.random() * list.length)];
    });
  };

  initRandom();
  document.addEventListener('astro:page-load', initRandom);

  /**
   * 「写作足迹」里一天多篇的格子：点开当天的文章列表，而不是跳进某一篇。
   *
   * 用 <a> 而不是 <button>：没有 JS 时它就是个正常链接（落到 href 里那篇），
   * 只是没法展开。点别处 / 按 Esc 收起。
   */
  const closeDay = (heat: Element) => {
    heat.classList.remove('is-open');
    heat.querySelectorAll<HTMLElement>('.heat__day').forEach((el) => {
      el.hidden = true;
    });
    heat.querySelectorAll<HTMLElement>('.heat__cell--multi').forEach((el) => {
      el.classList.remove('is-open');
      el.setAttribute('aria-expanded', 'false');
    });
  };

  const closeAllDays = () => {
    document.querySelectorAll('.heat').forEach(closeDay);
  };

  const initHeat = () => {
    document.querySelectorAll<HTMLElement>('.heat__cell--multi').forEach((cell) => {
      if (cell.dataset.bound === '1') return;
      cell.dataset.bound = '1';
      cell.addEventListener('click', (event) => {
        const heat = cell.closest('.heat');
        const day = heat?.querySelector<HTMLElement>(`.heat__day[data-day="${cell.dataset.day}"]`);
        if (!heat || !day) return; // 找不到列表就让它正常跳转
        const wasOpen = cell.classList.contains('is-open');
        event.preventDefault(); // 多篇：不跳具体文章
        closeDay(heat);
        if (wasOpen) return; // 再点一次＝收起
        day.hidden = false;
        cell.classList.add('is-open');
        cell.setAttribute('aria-expanded', 'true');
        heat.classList.add('is-open');
      });
    });
  };

  // 点别处 / Esc 收起。只绑一次：ClientRouter 导航时模块不重跑，但 document 一直在
  let outsideBound = false;
  if (!outsideBound) {
    outsideBound = true;
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest('.heat')) return;
      closeAllDays();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeAllDays();
    });
  }

  initHeat();
  document.addEventListener('astro:page-load', initHeat);
</script>
