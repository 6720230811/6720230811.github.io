---
import { useTranslations, type Locale } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<button
  class="navbar__search"
  type="button"
  id="search-switch"
  aria-label={t('search.open')}
  aria-expanded="false"
  aria-controls="search-panel"
>
  <Icon name="search" />
</button>

{/* 浮层面板：与窄屏导航菜单同一套 float-panel 样式 */}
<div
  class="float-panel float-panel--closed search-panel"
  id="search-panel"
  role="dialog"
  aria-label={t('search.open')}
  data-placeholder={t('search.placeholder')}
  data-hint={t('search.hint')}
  data-empty={t('search.empty')}
  data-results={t('search.results')}
  data-dev-only={t('search.devOnly')}
  data-failed={t('search.failed')}
  data-base={import.meta.env.BASE_URL}
  data-prod={String(import.meta.env.PROD)}
>
  <div class="search-panel__field">
    <Icon name="search" />
    <input
      class="search-panel__input"
      id="search-input"
      type="search"
      placeholder={t('search.placeholder')}
      autocomplete="off"
      spellcheck="false"
    />
  </div>

  <p class="search-panel__status" id="search-status">{t('search.hint')}</p>
  {/* data-lenis-prevent：自带滚动的容器，滚轮归它自己。没这个标记，Lenis 会把
      滚轮吃掉去滚正文 —— 而这里恰恰是「刚打完字就把鼠标放在结果上」的高频位置 */}
  <ul class="search-results" id="search-results" data-lenis-prevent></ul>
</div>

{/*
  这段脚本用 is:inline：pagefind 的索引是构建产物（/pagefind/pagefind.js），
  dev 下不存在、也不能让 Vite 解析。交给打包器处理时，Vite 会给动态 import
  套上 __vitePreload 并留下未定义的 __VITE_PRELOAD__ 占位符，运行时直接报错。
  is:inline 让脚本原样输出，import() 保持浏览器原生行为。
  代价：这里不能写 TS（不会被编译），需要的构建期信息由 data-* 属性传入。
*/}
<script is:inline>
  (() => {
    /*
      这段脚本会被反复执行，而 document 自始至终是同一个对象 —— 所以必须保证
      「无论跑多少遍，同一时刻只有一套监听活着」。

      为什么会反复执行：文档 parse 时跑一次，`astro:page-load` 每次触发再跑一次
      （首屏就会触发，所以首屏 init 就跑两遍）；换页时这段内联脚本还可能被整体
      重跑，那是另一份实例、另一套闭包 —— 「每份实例只管清理自己」挡不住跨实例叠加。

      叠起来的后果不是「多一次无用调用」，而是**功能直接坏掉**：一次点击跑 N 遍
      处理器，前一个刚 setOpen(true)、后一个看到「已经开着」立刻 setOpen(false)，
      表现成搜索按钮完全点不开。Navbar 的汉堡按钮踩过同一个坑，见那里的注释。

      做法：把「撤掉本实例」的句柄挂到 window 上，新实例进来先调旧的。
    */
    window.__searchCleanup?.();

    // 索引只加载一次，换页后仍然复用
    let loading;
    // 撤掉本实例当前这套监听。init 每跑一次就换一个新 controller，
    // 所以它同时也负责把「上一次绑的那套」撤掉。
    let cleanup = () => {};
    window.__searchCleanup = () => cleanup();

    const init = () => {
      cleanup();
      const ac = new AbortController();
      cleanup = () => ac.abort();

      const btn = document.getElementById('search-switch');
      const panel = document.getElementById('search-panel');
      const input = document.getElementById('search-input');
      const status = document.getElementById('search-status');
      const list = document.getElementById('search-results');
      if (!btn || !panel || !input || !status || !list) return;

      const str = (name) => panel.getAttribute(name) || '';
      const isProd = str('data-prod') === 'true';

      const load = () => {
        // 必须是绝对路径：页面在 /blog/ 之类的子路径下，相对路径会被解析到
        // /blog/pagefind/pagefind.js 而 404。
        // 另外 BASE_URL 在无子路径时是 '/'，不去掉结尾斜杠会拼成 '//pagefind/…'，
        // 浏览器会当成协议相对 URL、去解析 host 为 pagefind 的地址。
        const base = str('data-base').replace(/\/$/, '');
        loading =
          loading ||
          (async () => {
            const mod = await import(base + '/pagefind/pagefind.js');
            await mod.init();
            return mod;
          })();
        return loading;
      };

      const setOpen = (open) => {
        panel.classList.toggle('float-panel--closed', !open);
        btn.setAttribute('aria-expanded', String(open));
        if (open) input.focus();
        else input.value = '';
      };

      // 这个监听必须挂 signal。init() 在首屏会被跑两遍（脚本执行一次 +
      // astro:page-load 一次），而 cleanup() 只 abort 得掉挂了 signal 的那些 ——
      // 不挂就会留下两份处理器，一次点击跑两遍：前一个刚把面板打开，
      // 后一个看到「已经开着」又把它关回去，表现成**完全打不开**。
      // Navbar 的汉堡按钮踩过同一个坑（那里用 dataset.bound 防的）。
      btn.addEventListener(
        'click',
        () => {
          const willOpen = panel.classList.contains('float-panel--closed');
          setOpen(willOpen);
          // 面板一打开就预热索引，输入时不必再等
          if (willOpen) load().catch(() => {});
        },
        { signal: ac.signal }
      );

      // Esc 关闭；点击面板之外也关闭。
      // 这两个挂在 document 上，而 document 在换页后还是同一个，所以要用 signal 撤掉旧的
      document.addEventListener(
        'keydown',
        (e) => {
          if (e.key === 'Escape' && !panel.classList.contains('float-panel--closed')) {
            setOpen(false);
            btn.focus();
          }
        },
        { signal: ac.signal }
      );

      document.addEventListener(
        'click',
        (e) => {
          if (panel.classList.contains('float-panel--closed')) return;
          if (!panel.contains(e.target) && !btn.contains(e.target)) setOpen(false);
        },
        { signal: ac.signal }
      );

      const render = (items) => {
        list.textContent = '';
        for (const item of items) {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.className = 'search-result';
          a.href = item.url;

          const title = document.createElement('div');
          title.className = 'search-result__title';
          title.textContent = item.title;

          const excerpt = document.createElement('div');
          excerpt.className = 'search-result__excerpt';
          // pagefind 返回的摘要已转义，只含用于高亮的 <mark>
          excerpt.innerHTML = item.excerpt;

          a.append(title, excerpt);
          li.append(a);
          list.append(li);
        }
      };

      const search = async (term) => {
        const q = term.trim();
        if (!q) {
          status.textContent = str('data-hint');
          render([]);
          return;
        }

        status.textContent = '';
        try {
          const pf = await load();
          // 不传 filters：pagefind 已按 <html lang> 选中对应语言的索引，
          // 再按 lang 过滤只会与索引语言冲突、反而搜不到东西
          const res = await pf.debouncedSearch(q, {}, 220);
          // 被后续输入取代时返回 null，交给最后一次请求
          if (!res) return;
          if (res.results.length === 0) {
            status.textContent = str('data-empty');
            render([]);
            return;
          }
          status.textContent = str('data-results').replace('{n}', String(res.results.length));
          const items = await Promise.all(res.results.map((r) => r.data()));
          render(
            items.map((d) => ({
              url: d.url,
              title: d.meta.title || d.url,
              excerpt: d.excerpt,
            }))
          );
        } catch (e) {
          // 索引缺失（例如 dev 下 /pagefind/ 404）时允许重试，清掉缓存的 Promise
          loading = undefined;
          status.textContent = isProd ? str('data-failed') : str('data-dev-only');
          render([]);
        }
      };

      // 同 btn：不挂 signal 会绑两遍，每敲一个字都触发两次 search()
      input.addEventListener('input', () => search(input.value), { signal: ac.signal });

      // 重绑完再登记「下次换页继续重绑」。它挂在同一个 controller 上，
      // 于是下一次 init 一 abort 就会把它连同其它监听一起换掉 —— 恒为恰好一套。
      document.addEventListener('astro:page-load', init, { signal: ac.signal });
    };

    init();
  })();
</script>
